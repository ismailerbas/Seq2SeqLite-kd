#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:8
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu

# ============================================================================
# Teacher Seq2Seq GRU Training  (Cell 5/6/7 exact notebook replica)
# All 8 GPUs used via MirroredStrategy inside train_teacher.py.
#
# Architecture: stacked RNN([GRUCell(128), GRUCell(128)])
# Layer names:  encrnn / decrnn / decdense
# Decoder input: zeros (NOT TPSF) — Algorithm 3, lines 10-11
# Total params: 299,139
#
# Usage:
#   sbatch --job-name=teacher_seq2seq_gru128x2_bs16384 run_teacher.sh
#
# Optional positional args:
#   sbatch --job-name=teacher_seq2seq_gru128x2_bs16384 \
#          run_teacher.sh [SEQ_LEN] [N_TOTAL_M] [BATCH_SIZE] [LR] [EPOCHS]
# ============================================================================

SEQ_LEN=${1:-135}
N_TOTAL_M=${2:-8}
BATCH_SIZE=${3:-16384}
LR=${4:-8e-3}
EPOCHS=${5:-200}

# ============================================================================
# STEP 1 — modules
# No cuda/cudnn modules exist on this cluster — system-installed only.
# Only gcc is needed here.
# ============================================================================
module purge
module load gcc/9.3.0/1

# ============================================================================
# STEP 2 — activate conda
# ============================================================================
eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
conda activate tf210_qkeras

# ============================================================================
# STEP 3 — THE FIX
# libcudnn.so.8 is in $CONDA_PREFIX/lib but LD_LIBRARY_PATH is empty on
# this cluster. TF cannot find cuDNN without this one export.
# Confirmed working: 8x V100 detected after this line.
# ============================================================================
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

# ============================================================================
# STEP 4 — GPU / TF settings
# ============================================================================
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export TF_CPP_MIN_LOG_LEVEL=2
export TF_ENABLE_ONEDNN_OPTS=0
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# --- Paths ---
SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"
DATA_PATH="${SCRATCH_BASE}/nmi"
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# --- Scratch / cache dirs ---
export TMPDIR="${SCRATCH_BASE}/tmp_pip"
export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"
export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"
export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"
export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}" "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

# --- Log ---
echo "============================================================"
echo "TEACHER SEQ2SEQ GRU TRAINING  (notebook Cell 5/6/7 replica)"
echo "MirroredStrategy — all 8 GPUs"
echo "============================================================"
echo "SLURM JOB ID   : ${SLURM_JOBID}"
echo "SLURM JOB NAME : ${SLURM_JOB_NAME}"
echo "NODE           : $(hostname)"
echo "CUDA_VISIBLE_DEVICES : ${CUDA_VISIBLE_DEVICES}"
echo "LD_LIBRARY_PATH: ${LD_LIBRARY_PATH}"
echo "GPUs available : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l)"
echo "GPU names      : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
echo "DATA PATH      : ${DATA_PATH}"
echo "SCRIPT DIR     : ${SCRIPT_DIR}"
echo "SEQ LEN        : ${SEQ_LEN}"
echo "N TOTAL M      : ${N_TOTAL_M}"
echo "BATCH SIZE     : ${BATCH_SIZE}"
echo "LR             : ${LR}"
echo "EPOCHS         : ${EPOCHS}"
echo "ARCHITECTURE   : encrnn/decrnn = RNN([GRUCell(128), GRUCell(128)])"
echo "DECODER INPUT  : zeros (NOT TPSF)"
echo "EXPECTED PARAMS: 299,139"
echo "OUTPUTS TO     : ${DATA_PATH}/teacher_best.weights.h5"
echo "PYTHON         : $(which python)"
echo "TF VERSION     : $(python -c 'import tensorflow as tf; print(tf.__version__)' 2>/dev/null)"
echo "NUMPY VERSION  : $(python -c 'import numpy as np; print(np.__version__)' 2>/dev/null)"

# --- GPU sanity check ---
GPU_CHECK=$(python -c "import tensorflow as tf; gpus=tf.config.list_physical_devices('GPU'); print(len(gpus))" 2>/dev/null)
echo "TF physical GPUs found : ${GPU_CHECK}"
if [ "${GPU_CHECK}" = "0" ] || [ -z "${GPU_CHECK}" ]; then
    echo "FATAL: TensorFlow found 0 GPUs."
    echo "Check LD_LIBRARY_PATH includes \$CONDA_PREFIX/lib"
    echo "libcudnn.so.8 location:"
    find "${CONDA_PREFIX}/lib" -name "libcudnn.so.8" 2>/dev/null
    exit 1
fi

echo "============================================================"

if [ ! -f "${SCRIPT_DIR}/train_teacher.py" ]; then
    echo "FATAL: train_teacher.py not found in ${SCRIPT_DIR}"
    exit 1
fi
echo "train_teacher.py found."
echo "Starting teacher training..."

python "${SCRIPT_DIR}/train_teacher.py" \
    --data-dir       "${DATA_PATH}"   \
    --seq-len        "${SEQ_LEN}"     \
    --n-total-m      "${N_TOTAL_M}"   \
    --n-out          3                \
    --gate-width-ns  0.09             \
    --batch-size     "${BATCH_SIZE}"  \
    --epochs         "${EPOCHS}"      \
    --lr             "${LR}"          \
    --patience       8                \
    --min-delta      1e-5             \
    --lr-factor      0.5              \
    --lr-patience    4                \
    --lr-min         1e-6             \
    --val-frac       0.1              \
    --test-frac      0.1              \
    --split-seed     42               \
    --infer-batch    8192

EXIT_CODE=$?

echo "============================================================"
echo "Training Exit Code: ${EXIT_CODE}"
if [ ${EXIT_CODE} -eq 0 ]; then
    echo "Completed successfully."
    echo "Outputs in: ${DATA_PATH}"
    echo "  H5 checkpoint : $(find "${DATA_PATH}" -maxdepth 1 -name "teacher_best.weights.h5" 2>/dev/null)"
    echo "  Split indices : $(find "${DATA_PATH}" -maxdepth 1 -name "trainidx.npy" -o -name "validx.npy" -o -name "testidx.npy" 2>/dev/null | tr '\n' ' ')"
    echo "  PNGs  : $(find "${DATA_PATH}" -maxdepth 1 -name "teacher_*.png"  2>/dev/null | wc -l)"
    echo "  JSONs : $(find "${DATA_PATH}" -maxdepth 1 -name "teacher_*.json" 2>/dev/null | wc -l)"
    echo "  CSVs  : $(find "${DATA_PATH}" -maxdepth 1 -name "teacher_*.csv"  2>/dev/null | wc -l)"
else
    echo "FAILED (exit code: ${EXIT_CODE})"
    echo "Check: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
    echo "Hint:"
    echo "  grep -i 'error\|traceback\|valueerror\|assertionerror' \\"
    echo "       slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err | head -40"
fi
echo "============================================================"
echo "Log files:"
echo "  Out: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"
echo "  Err: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
echo "============================================================"

exit ${EXIT_CODE}