#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=04:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu

# ============================================================================
# eval_teacher_sdf — post-hoc SDF metric evaluation for teacher ablations
# Produces test_sdf_metrics.json (RMSE, R², L2-norm, DTW per SDF channel)
# and test_metrics.json (tau1, tau2, FRET) for every teacher run found under
# --results-dir (i.e. /scratch/nmi).  Corresponds to Table 1 in the paper.
#
# No resubmission logic needed here: eval is read-only, deterministic, and
# fast enough to complete within 4h.  If it times out, resubmit with
# --overwrite and increase wall time.
#
# Positional args:
#   $1  SEQ_LEN            (optional, default 135)
#   $2  N_TOTAL_M          (optional, default 8)
#   $3  INFER_BATCH        (optional, default 8192)
#   $4  OVERWRITE          (optional, pass "overwrite" to add --overwrite flag)
#
# Examples:
#   sbatch --job-name=eval_teacher_sdf slurm/eval_teacher_sdf
#   sbatch --job-name=eval_teacher_sdf slurm/eval_teacher_sdf 135 8 8192 overwrite
# ============================================================================

SEQ_LEN=${1:-135}
N_TOTAL_M=${2:-8}
INFER_BATCH=${3:-8192}
OVERWRITE_ARG=""
if [ "${4}" = "overwrite" ]; then
    OVERWRITE_ARG="--overwrite"
fi

# ============================================================================
# STEP 1 — modules
# ============================================================================
module purge
module load gcc/9.3.0/1

# ============================================================================
# STEP 2 — activate conda
# ============================================================================
eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
conda activate tf210_qkeras

# ============================================================================
# STEP 3 — THE FIX
# ============================================================================
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

# ============================================================================
# STEP 4 — GPU / TF settings
# ============================================================================
export CUDA_VISIBLE_DEVICES=0
export TF_CPP_MIN_LOG_LEVEL=2
export TF_ENABLE_ONEDNN_OPTS=0
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# --- Paths ---
SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"
DATA_PATH="${SCRATCH_BASE}/nmi"
RESULTS_PATH="${SCRATCH_BASE}/nmi"
SCRIPT_DIR="/gpfs/u/scratch/HBNN/HBNNrbss/nmi"

# --- Scratch / cache dirs ---
export TMPDIR="${SCRATCH_BASE}/tmp_pip"
export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"
export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"
export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"
export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}" "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

# --- Log ---
echo "============================================================"
echo "EVAL TEACHER SDF — Table 1"
echo "Scanning ${RESULTS_PATH} for teacher_best.weights.h5"
echo "============================================================"
echo "SLURM JOB ID        : ${SLURM_JOBID}"
echo "SLURM JOB NAME      : ${SLURM_JOB_NAME}"
echo "NODE                : $(hostname)"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES}"
echo "LD_LIBRARY_PATH     : ${LD_LIBRARY_PATH}"
echo "GPUs available      : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l)"
echo "GPU names           : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
echo "DATA PATH           : ${DATA_PATH}"
echo "RESULTS PATH        : ${RESULTS_PATH}"
echo "SCRIPT DIR          : ${SCRIPT_DIR}"
echo "SEQ LEN             : ${SEQ_LEN}"
echo "INFER BATCH         : ${INFER_BATCH}"
echo "OVERWRITE ARG       : ${OVERWRITE_ARG}"
echo "PYTHON              : $(which python)"
echo "TF VERSION          : $(python -c 'import tensorflow as tf; print(tf.__version__)' 2>/dev/null)"
echo "NUMPY VERSION       : $(python -c 'import numpy as np; print(np.__version__)' 2>/dev/null)"
echo "============================================================"

# --- GPU sanity check ---
GPU_CHECK=$(python -c "import tensorflow as tf; gpus=tf.config.list_physical_devices('GPU'); print(len(gpus))" 2>/dev/null)
echo "TF physical GPUs found : ${GPU_CHECK}"
if [ "${GPU_CHECK}" = "0" ] || [ -z "${GPU_CHECK}" ]; then
    echo "FATAL: TensorFlow found 0 GPUs."
    echo "Check LD_LIBRARY_PATH includes \$CONDA_PREFIX/lib"
    find "${CONDA_PREFIX}/lib" -name "libcudnn.so.8" 2>/dev/null
    exit 1
fi

if [ ! -f "${SCRIPT_DIR}/eval/eval_teacher_sdf.py" ]; then
    echo "FATAL: eval/eval_teacher_sdf.py not found in ${SCRIPT_DIR}/eval/"
    exit 1
fi
echo "eval_teacher_sdf.py found."
echo "Starting evaluation..."
echo "============================================================"

# ============================================================================
# Launch eval (foreground — no resubmission needed for eval jobs)
# ============================================================================
python "${SCRIPT_DIR}/eval/eval_teacher_sdf.py" \
    --data-dir          "${DATA_PATH}"    \
    --results-dir       "${RESULTS_PATH}" \
    --seq-len           "${SEQ_LEN}"      \
    --n-out             3                 \
    --gate-width-ns     0.09              \
    --teacher-units     128               \
    --teacher-layers    2                 \
    --infer-batch       "${INFER_BATCH}"  \
    ${OVERWRITE_ARG}

EXIT_CODE=$?

echo "============================================================"
echo "Eval Exit Code: ${EXIT_CODE}"
if [ ${EXIT_CODE} -eq 0 ]; then
    echo "Evaluation completed successfully."
    echo "Results written next to each teacher_best.weights.h5 under:"
    echo "  ${RESULTS_PATH}"
    echo "  Files per run: test_sdf_metrics.json  test_metrics.json"
    echo "  JSON count: $(find "${RESULTS_PATH}" -name "test_sdf_metrics.json" 2>/dev/null | wc -l) test_sdf_metrics.json found"
else
    echo "FAILED (exit code: ${EXIT_CODE})"
    echo "Check: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
    echo "  grep -i 'error\|traceback\|valueerror\|assertionerror' \\"
    echo "       slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err | head -40"
fi
echo "============================================================"
echo "Log files:"
echo "  Out: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"
echo "  Err: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
echo "============================================================"

exit ${EXIT_CODE}