#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu

# ============================================================================
# eval_ptq_sdf — Weight-only PTQ evaluation for Table 2.
# Auto-discovers all teacher runs under /scratch/nmi that contain
# teacher_best.weights.h5, applies symmetric per-tensor weight-only
# quantization at 8-bit and/or 16-bit, runs batched GPU inference on the
# frozen test split, and saves results under:
#   /scratch/nmi/ptq/ptq_{bits}bit_{run_name}/
#
# No TFLite.  Quantized weights are set back via layer.set_weights() and
# inference runs at full float32 speed on GPU using the normal Keras path.
# Wall time 8h covers worst-case DTW on the full test set for all runs
# at both bit-widths.  No resubmission logic: eval is deterministic.
#
# Positional args:
#   $1  BITS        (optional, default "both"  — choices: 8 / 16 / both)
#   $2  SEQ_LEN     (optional, default 135)
#   $3  INFER_BATCH (optional, default 8192)
#   $4  OVERWRITE   (optional, pass "overwrite" to add --overwrite flag)
#
# Examples:
#   # Run both 8-bit and 16-bit on all discovered teacher runs:
#   sbatch --job-name=eval_ptq_both slurm/eval_ptq_sdf
#
#   # Run only 8-bit:
#   sbatch --job-name=eval_ptq_8bit slurm/eval_ptq_sdf 8
#
#   # Run only 16-bit:
#   sbatch --job-name=eval_ptq_16bit slurm/eval_ptq_sdf 16
#
#   # Run both bit-widths with overwrite:
#   sbatch --job-name=eval_ptq_both slurm/eval_ptq_sdf both 135 8192 overwrite
#
#   # Run only 8-bit with overwrite:
#   sbatch --job-name=eval_ptq_8bit slurm/eval_ptq_sdf 8 135 8192 overwrite
# ============================================================================

BITS=${1:-both}
SEQ_LEN=${2:-135}
INFER_BATCH=${3:-8192}
OVERWRITE_ARG=""
if [ "${4}" = "overwrite" ]; then
    OVERWRITE_ARG="--overwrite"
fi

# Validate BITS
if [ "${BITS}" != "8" ] && [ "${BITS}" != "16" ] && [ "${BITS}" != "both" ]; then
    echo "FATAL: BITS must be 8, 16, or both. Got: ${BITS}"
    exit 1
fi

# ============================================================================
# STEP 1 — modules
# ============================================================================
module purge
module load gcc/9.3.0/1

# ============================================================================
# STEP 2 — activate conda
# ============================================================================
eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
conda activate tf210_qkeras

# ============================================================================
# STEP 3 — THE FIX
# ============================================================================
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

# ============================================================================
# STEP 4 — GPU / TF settings
# ============================================================================
export CUDA_VISIBLE_DEVICES=0
export TF_CPP_MIN_LOG_LEVEL=2
export TF_ENABLE_ONEDNN_OPTS=0
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# --- Paths ---
SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"
DATA_PATH="${SCRATCH_BASE}/nmi"
RESULTS_PATH="${SCRATCH_BASE}/nmi"
SCRIPT_DIR="/gpfs/u/scratch/HBNN/HBNNrbss/nmi"

# --- Scratch / cache dirs ---
export TMPDIR="${SCRATCH_BASE}/tmp_pip"
export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"
export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"
export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"
export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}" "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"
mkdir -p "${RESULTS_PATH}/ptq"

# --- Log ---
echo "============================================================"
echo "EVAL PTQ SDF — Table 2"
echo "Weight-only PTQ at ${BITS}-bit on all discovered teacher runs"
echo "Auto-discovers all teacher_best.weights.h5 under ${RESULTS_PATH}"
echo "============================================================"
echo "SLURM JOB ID        : ${SLURM_JOBID}"
echo "SLURM JOB NAME      : ${SLURM_JOB_NAME}"
echo "NODE                : $(hostname)"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES}"
echo "LD_LIBRARY_PATH     : ${LD_LIBRARY_PATH}"
echo "GPUs available      : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l)"
echo "GPU names           : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
echo "DATA PATH           : ${DATA_PATH}"
echo "RESULTS PATH        : ${RESULTS_PATH}"
echo "SCRIPT DIR          : ${SCRIPT_DIR}"
echo "BITS                : ${BITS}"
echo "SEQ LEN             : ${SEQ_LEN}"
echo "INFER BATCH         : ${INFER_BATCH}"
echo "OVERWRITE ARG       : ${OVERWRITE_ARG}"
echo "PYTHON              : $(which python)"
echo "TF VERSION          : $(python -c 'import tensorflow as tf; print(tf.__version__)' 2>/dev/null)"
echo "NUMPY VERSION       : $(python -c 'import numpy as np; print(np.__version__)' 2>/dev/null)"
echo "============================================================"

# --- GPU sanity check ---
GPU_CHECK=$(python -c "import tensorflow as tf; gpus=tf.config.list_physical_devices('GPU'); print(len(gpus))" 2>/dev/null)
echo "TF physical GPUs found : ${GPU_CHECK}"
if [ "${GPU_CHECK}" = "0" ] || [ -z "${GPU_CHECK}" ]; then
    echo "FATAL: TensorFlow found 0 GPUs."
    echo "Check LD_LIBRARY_PATH includes \$CONDA_PREFIX/lib"
    find "${CONDA_PREFIX}/lib" -name "libcudnn.so.8" 2>/dev/null
    exit 1
fi

if [ ! -f "${SCRIPT_DIR}/eval/eval_ptq_sdf.py" ]; then
    echo "FATAL: eval/eval_ptq_sdf.py not found in ${SCRIPT_DIR}/eval/"
    exit 1
fi

echo "eval_ptq_sdf.py found."
echo "Starting weight-only PTQ ${BITS}-bit evaluation on all teacher runs..."
echo "============================================================"

# ============================================================================
# Launch eval (foreground)
# ============================================================================
python "${SCRIPT_DIR}/eval/eval_ptq_sdf.py" \
    --data-dir          "${DATA_PATH}"     \
    --results-dir       "${RESULTS_PATH}"  \
    --bits              "${BITS}"          \
    --seq-len           "${SEQ_LEN}"       \
    --n-out             3                  \
    --gate-width-ns     0.09               \
    --teacher-units     128                \
    --teacher-layers    2                  \
    --infer-batch       "${INFER_BATCH}"   \
    ${OVERWRITE_ARG}

EXIT_CODE=$?

echo "============================================================"
echo "Eval Exit Code: ${EXIT_CODE}"
if [ ${EXIT_CODE} -eq 0 ]; then
    echo "PTQ ${BITS}-bit evaluation completed successfully."
    echo "Results saved under: ${RESULTS_PATH}/ptq/"
    echo "  Subdirs  : $(find "${RESULTS_PATH}/ptq" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
    echo "  JSONs    : $(find "${RESULTS_PATH}/ptq" -name "*.json" 2>/dev/null | wc -l)"
    echo "  PNGs     : $(find "${RESULTS_PATH}/ptq" -name "*.png"  2>/dev/null | wc -l)"
else
    echo "FAILED (exit code: ${EXIT_CODE})"
    echo "Check: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
    echo "  grep -i 'error\|traceback\|valueerror\|assertionerror' \\"
    echo "       slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err | head -40"
fi
echo "============================================================"
echo "Log files:"
echo "  Out: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"
echo "  Err: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
echo "============================================================"

exit ${EXIT_CODE}