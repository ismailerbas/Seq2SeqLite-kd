#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=06:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu

set -u

# ============================================================================
# analyze_memoq_deadzone
#
# Post-hoc hidden-state resolution analysis for the exact MemoQ paper run.
#
# IMPORTANT:
# This job uses the source files physically present on the server.
# The server source directory does NOT need to be a Git checkout.
# No Git command, Git branch, Git hash, GitHub connection, or .git directory
# is required.
#
# Server source:
#   /gpfs/u/scratch/HBNN/HBNNrbss/nmi/train_student_memoq.py
#   /gpfs/u/scratch/HBNN/HBNNrbss/nmi/eval/analyze_memoq_deadzone.py
#
# Historical paper checkpoints:
#   stage2d_best.weights.h5
#   stage2e_best.weights.h5
#   stage2f_best.weights.h5
#
# The analysis is inference-only.
# No checkpoint is modified, trained, fine-tuned, or overwritten.
#
# The Python program validates the reconstruction by recomputing sequence MAE
# and comparing it against the saved test_metrics_P2D.json,
# test_metrics_P2E.json, and test_metrics_P2F.json before accepting any
# hidden-state result.
#
# Output directory:
#   <RUN_DIR>/deadzone_analysis
#
# Outputs:
#   deadzone_summary.json
#   deadzone_summary.csv
#   deadzone_per_unit.csv
#   deadzone_per_sequence.npz
#   deadzone_update_histogram.csv
#   deadzone_update_cdf_full.png
#   deadzone_update_cdf_zoom.png
#   deadzone_dead_fraction_per_unit.png
#   deadzone_same_bin_fraction_per_unit.png
#   deadzone_summary_percent.png
#   deadzone_manifest.json
#   deadzone_complete.flag
# ============================================================================


# ============================================================================
# STEP 1 — modules
# ============================================================================

module purge
module load gcc/9.3.0/1


# ============================================================================
# STEP 2 — activate the existing TensorFlow/QKeras environment
# ============================================================================

eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"

conda activate tf210_qkeras


# ============================================================================
# STEP 3 — cuDNN / CUDA runtime library path
# ============================================================================

export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"


# ============================================================================
# STEP 4 — TensorFlow / CPU thread settings
# ============================================================================

export CUDA_VISIBLE_DEVICES=0

export TF_CPP_MIN_LOG_LEVEL=2

export TF_ENABLE_ONEDNN_OPTS=0

export OMP_NUM_THREADS=1

export MKL_NUM_THREADS=1

export OPENBLAS_NUM_THREADS=1


# ============================================================================
# Exact server paths
# ============================================================================

SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"

SCRIPT_DIR="/gpfs/u/scratch/HBNN/HBNNrbss/nmi"

DATA_PATH="/gpfs/u/scratch/HBNN/HBNNrbss/nmi"

RUN_DIR="/gpfs/u/home/HBNN/HBNNrbss/scratch/nmi/bozukolanveyamemoq/memoq_b4k4r4a4s4_gru32_dense3_effbs1024_microbs1024_lr1e-04_p1-40_2a30_2b30_2c10_p3-170p2fcalismadipapericinkullan"

OUT_DIR="${RUN_DIR}/deadzone_analysis"

PYTHON_SCRIPT="${SCRIPT_DIR}/eval/analyze_memoq_deadzone.py"

TRAIN_MEMOQ_SCRIPT="${SCRIPT_DIR}/train_student_memoq.py"

SLURM_SCRIPT="${SCRIPT_DIR}/slurm/analyze_memoq_deadzone"


# ============================================================================
# Exact dead-zone analysis settings
# ============================================================================

INFER_BATCH=4096

HIGH_Z_THRESHOLD=0.90

BOOTSTRAP_REPS=2000

BOOTSTRAP_SEED=42

BOOTSTRAP_BATCH_REPS=32

HIST_BINS=4096

MAE_TOLERANCE=5e-5


# ============================================================================
# Scratch and cache directories
# ============================================================================

export TMPDIR="${SCRATCH_BASE}/tmp_pip"

export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"

export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"

export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"

export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"


mkdir -p \
    "${TMPDIR}" \
    "${PIP_CACHE_DIR}" \
    "${PIP_TMPDIR}" \
    "${MPLCONFIGDIR}" \
    "${XDG_CACHE_HOME}" \
    "${OUT_DIR}"


# ============================================================================
# Server source-file checks
# ============================================================================

if [ ! -d "${SCRIPT_DIR}" ]; then
    echo "FATAL: server source directory does not exist:"
    echo "  ${SCRIPT_DIR}"
    exit 1
fi


if [ ! -f "${TRAIN_MEMOQ_SCRIPT}" ]; then
    echo "FATAL: train_student_memoq.py does not exist:"
    echo "  ${TRAIN_MEMOQ_SCRIPT}"
    exit 1
fi


if [ ! -f "${PYTHON_SCRIPT}" ]; then
    echo "FATAL: analyze_memoq_deadzone.py does not exist:"
    echo "  ${PYTHON_SCRIPT}"
    exit 1
fi


if [ ! -f "${SLURM_SCRIPT}" ]; then
    echo "FATAL: analyze_memoq_deadzone SLURM launcher does not exist:"
    echo "  ${SLURM_SCRIPT}"
    exit 1
fi


if [ ! -d "${DATA_PATH}" ]; then
    echo "FATAL: data directory does not exist:"
    echo "  ${DATA_PATH}"
    exit 1
fi


if [ ! -d "${RUN_DIR}" ]; then
    echo "FATAL: paper-run directory does not exist:"
    echo "  ${RUN_DIR}"
    exit 1
fi


# ============================================================================
# Historical paper-run artifact checks
# ============================================================================

for REQUIRED_FILE in \
    "student_args.json" \
    "stage2d_best.weights.h5" \
    "stage2e_best.weights.h5" \
    "stage2f_best.weights.h5" \
    "test_metrics_P2D.json" \
    "test_metrics_P2E.json" \
    "test_metrics_P2F.json"
do
    if [ ! -f "${RUN_DIR}/${REQUIRED_FILE}" ]; then
        echo "FATAL: required paper-run artifact is missing:"
        echo "  ${RUN_DIR}/${REQUIRED_FILE}"
        exit 1
    fi
done


# ============================================================================
# Record ordinary SHA256 hashes of the server files.
#
# These hashes are informational provenance only.
# They do NOT control whether the analysis is allowed to run.
# They do NOT compare against Git or GitHub.
# ============================================================================

TRAIN_MEMOQ_SHA256=$(
    sha256sum "${TRAIN_MEMOQ_SCRIPT}" |
    awk '{print $1}'
)

ANALYSIS_SHA256=$(
    sha256sum "${PYTHON_SCRIPT}" |
    awk '{print $1}'
)

SLURM_SHA256=$(
    sha256sum "${SLURM_SCRIPT}" |
    awk '{print $1}'
)

STUDENT_ARGS_SHA256=$(
    sha256sum "${RUN_DIR}/student_args.json" |
    awk '{print $1}'
)


# ============================================================================
# Environment information
# ============================================================================

PYTHON_PATH=$(which python)

TF_VERSION=$(
    python -c \
    'import tensorflow as tf; print(tf.__version__)' \
    2>/dev/null
)

QKERAS_VERSION=$(
    python -c \
    'import qkeras; print(getattr(qkeras, "__version__", "n/a"))' \
    2>/dev/null
)

NUMPY_VERSION=$(
    python -c \
    'import numpy as np; print(np.__version__)' \
    2>/dev/null
)


# ============================================================================
# Log header
# ============================================================================

echo "================================================================================"
echo "MEMOQ DEAD-ZONE ANALYSIS — PAPER RUN"
echo "================================================================================"

echo "SLURM JOB ID          : ${SLURM_JOBID}"
echo "SLURM JOB NAME        : ${SLURM_JOB_NAME}"
echo "NODE                  : $(hostname)"

echo "CUDA_VISIBLE_DEVICES  : ${CUDA_VISIBLE_DEVICES}"
echo "LD_LIBRARY_PATH       : ${LD_LIBRARY_PATH}"

echo "GPUs available        : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l)"

echo "GPU names             : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | tr '\n' ',' | sed 's/,$//')"

echo "SOURCE MODE           : server files used directly"

echo "SCRIPT DIR            : ${SCRIPT_DIR}"

echo "TRAIN MEMOQ SCRIPT    : ${TRAIN_MEMOQ_SCRIPT}"

echo "TRAIN MEMOQ SHA256    : ${TRAIN_MEMOQ_SHA256}"

echo "PYTHON SCRIPT         : ${PYTHON_SCRIPT}"

echo "ANALYSIS SHA256       : ${ANALYSIS_SHA256}"

echo "SLURM SCRIPT          : ${SLURM_SCRIPT}"

echo "SLURM SHA256          : ${SLURM_SHA256}"

echo "DATA PATH             : ${DATA_PATH}"

echo "RUN DIR               : ${RUN_DIR}"

echo "OUT DIR               : ${OUT_DIR}"

echo "STUDENT ARGS SHA256   : ${STUDENT_ARGS_SHA256}"

echo "INFER BATCH           : ${INFER_BATCH}"

echo "HIGH-Z THRESHOLD      : ${HIGH_Z_THRESHOLD}"

echo "BOOTSTRAP REPS        : ${BOOTSTRAP_REPS}"

echo "BOOTSTRAP SEED        : ${BOOTSTRAP_SEED}"

echo "BOOTSTRAP BATCH REPS  : ${BOOTSTRAP_BATCH_REPS}"

echo "HIST BINS             : ${HIST_BINS}"

echo "MAE TOLERANCE         : ${MAE_TOLERANCE}"

echo "PYTHON                : ${PYTHON_PATH}"

echo "TF VERSION            : ${TF_VERSION}"

echo "QKERAS VERSION        : ${QKERAS_VERSION}"

echo "NUMPY VERSION         : ${NUMPY_VERSION}"

echo "================================================================================"


# ============================================================================
# Historical checkpoint information
# ============================================================================

echo "Historical checkpoint timestamps:"

stat -c '%y  %n' \
    "${RUN_DIR}/stage2d_best.weights.h5" \
    "${RUN_DIR}/stage2e_best.weights.h5" \
    "${RUN_DIR}/stage2f_best.weights.h5"

echo "================================================================================"


echo "Historical metrics files:"

echo "P2D:"
cat "${RUN_DIR}/test_metrics_P2D.json"

echo ""

echo "P2E:"
cat "${RUN_DIR}/test_metrics_P2E.json"

echo ""

echo "P2F:"
cat "${RUN_DIR}/test_metrics_P2F.json"

echo ""

echo "================================================================================"


# ============================================================================
# GPU sanity check
# ============================================================================

GPU_CHECK=$(
    python -c \
    "import tensorflow as tf; gpus=tf.config.list_physical_devices('GPU'); print(len(gpus))" \
    2>/dev/null
)


echo "TensorFlow physical GPUs found: ${GPU_CHECK}"


if [ "${GPU_CHECK}" = "0" ] || [ -z "${GPU_CHECK}" ]; then

    echo "FATAL: TensorFlow found zero GPUs."

    echo "CONDA_PREFIX:"
    echo "  ${CONDA_PREFIX}"

    echo "Searching for libcudnn.so.8:"

    find "${CONDA_PREFIX}/lib" \
        -name "libcudnn.so.8" \
        2>/dev/null

    exit 1

fi


# ============================================================================
# Python syntax/import sanity check
# ============================================================================

python -m py_compile "${PYTHON_SCRIPT}"

PYCOMPILE_EXIT=$?


if [ ${PYCOMPILE_EXIT} -ne 0 ]; then
    echo "FATAL: Python syntax validation failed."
    exit ${PYCOMPILE_EXIT}
fi


echo "Python syntax validation passed."


# ============================================================================
# Launch deterministic post-hoc analysis
# ============================================================================

echo "Starting MemoQ dead-zone analysis..."

echo "================================================================================"


python "${PYTHON_SCRIPT}" \
    --run-dir "${RUN_DIR}" \
    --data-dir "${DATA_PATH}" \
    --out-dir "${OUT_DIR}" \
    --phases P2D P2E P2F \
    --infer-batch "${INFER_BATCH}" \
    --high-z-threshold "${HIGH_Z_THRESHOLD}" \
    --bootstrap-reps "${BOOTSTRAP_REPS}" \
    --bootstrap-seed "${BOOTSTRAP_SEED}" \
    --bootstrap-batch-reps "${BOOTSTRAP_BATCH_REPS}" \
    --hist-bins "${HIST_BINS}" \
    --mae-tolerance "${MAE_TOLERANCE}"


EXIT_CODE=$?


# ============================================================================
# Final validation and summary
# ============================================================================

echo "================================================================================"

echo "Dead-zone analysis exit code: ${EXIT_CODE}"


if [ ${EXIT_CODE} -eq 0 ]; then

    if [ ! -f "${OUT_DIR}/deadzone_complete.flag" ]; then
        echo "FATAL: Python exited successfully but deadzone_complete.flag is missing."
        exit 1
    fi


    if [ ! -f "${OUT_DIR}/deadzone_summary.csv" ]; then
        echo "FATAL: deadzone_summary.csv is missing."
        exit 1
    fi


    if [ ! -f "${OUT_DIR}/deadzone_summary.json" ]; then
        echo "FATAL: deadzone_summary.json is missing."
        exit 1
    fi


    if [ ! -f "${OUT_DIR}/deadzone_manifest.json" ]; then
        echo "FATAL: deadzone_manifest.json is missing."
        exit 1
    fi


    echo "Analysis completed successfully."

    echo ""

    echo "Results directory:"
    echo "  ${OUT_DIR}"

    echo ""

    echo "deadzone_summary.csv:"
    echo "--------------------------------------------------------------------------------"

    cat "${OUT_DIR}/deadzone_summary.csv"

    echo "--------------------------------------------------------------------------------"

    echo ""

    echo "deadzone_manifest.json:"
    echo "--------------------------------------------------------------------------------"

    cat "${OUT_DIR}/deadzone_manifest.json"

    echo "--------------------------------------------------------------------------------"

    echo ""

    echo "All output files:"

    ls -lah "${OUT_DIR}"

else

    echo "Analysis FAILED."

    echo "Exit code:"
    echo "  ${EXIT_CODE}"

    echo ""

    echo "Stdout:"
    echo "  slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"

    echo ""

    echo "Stderr:"
    echo "  slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"

    echo ""

    echo "Relevant stderr lines:"

    grep -i \
        'error\|traceback\|runtimeerror\|valueerror\|fidelity\|fatal' \
        "slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err" \
        2>/dev/null |
        head -100

fi


echo "================================================================================"

echo "Log files:"

echo "  Out: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"

echo "  Err: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"

echo "================================================================================"


exit ${EXIT_CODE}