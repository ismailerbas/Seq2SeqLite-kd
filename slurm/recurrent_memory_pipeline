backup_completion_flag() {
    local flag=$1

    if [[ -f "${flag}" ]]; then
        local timestamp
        timestamp=$(date '+%Y%m%d_%H%M%S')

        mv \
            "${flag}" \
            "${flag}.stale_${timestamp}"

        log "Preserved stale completion flag as ${flag}.stale_${timestamp}"
    fi
}


condition_matches_request() {
    local out_dir=$1
    local condition_name=$2
    local run_dir=$3
    local phase=$4
    local method=$5
    local state_bits=$6
    local residual_bits=$7
    local counter_bits=$8
    local deadzone=$9
    local fidelity_json=${10}

    local complete_flag="${out_dir}/recurrent_memory_complete.flag"
    local summary="${out_dir}/recurrent_memory_summary.json"
    local manifest="${out_dir}/recurrent_memory_manifest.json"
    local prediction="${out_dir}/recurrent_memory_per_sequence.npz"

    if [[ ! -f "${complete_flag}" ]]; then
        return 1
    fi

    if [[ ! -f "${summary}" ]]; then
        return 1
    fi

    if [[ ! -f "${manifest}" ]]; then
        return 1
    fi

    if [[ ! -f "${prediction}" ]]; then
        return 1
    fi

    python - \
        "${complete_flag}" \
        "${summary}" \
        "${manifest}" \
        "${condition_name}" \
        "${run_dir}" \
        "${phase}" \
        "${method}" \
        "${state_bits}" \
        "${residual_bits}" \
        "${counter_bits}" \
        "${deadzone}" \
        "${fidelity_json}" \
        "${ANALYSIS_SCRIPT}" \
        "${BASE_ANALYSIS_SCRIPT}" <<'PY'
import hashlib
import json
import math
import sys
from pathlib import Path

(
    complete_flag,
    summary_path,
    manifest_path,
    condition_name,
    run_dir,
    phase,
    method,
    state_bits,
    residual_bits,
    counter_bits,
    deadzone,
    fidelity_json,
    analysis_script,
    base_analysis_script,
) = sys.argv[1:]


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        while True:
            block = handle.read(1024 * 1024)
            if not block:
                break
            digest.update(block)
    return digest.hexdigest()


with open(complete_flag, "r", encoding="utf-8") as handle:
    flag_value = handle.read().strip()

if flag_value != condition_name:
    raise SystemExit(1)

with open(summary_path, "r", encoding="utf-8") as handle:
    summary = json.load(handle)

with open(manifest_path, "r", encoding="utf-8") as handle:
    manifest = json.load(handle)

if summary.get("condition_name") != condition_name:
    raise SystemExit(1)

if manifest.get("condition_name") != condition_name:
    raise SystemExit(1)

if summary.get("phase") != phase:
    raise SystemExit(1)

if manifest.get("phase") != phase:
    raise SystemExit(1)

if summary.get("method") != method:
    raise SystemExit(1)

if manifest.get("run_dir") != str(Path(run_dir).resolve()):
    raise SystemExit(1)

adapter = summary.get("adapter_equivalence")

if not isinstance(adapter, dict) or adapter.get("passed") is not True:
    raise SystemExit(1)

operator = summary.get("operator")

if not isinstance(operator, dict):
    raise SystemExit(1)

if int(operator.get("state_bits")) != int(state_bits):
    raise SystemExit(1)

expected_residual = int(residual_bits)

if expected_residual >= 0:
    if int(operator.get("residual_bits")) != expected_residual:
        raise SystemExit(1)

expected_counter = int(counter_bits)

if expected_counter >= 0:
    if int(operator.get("counter_bits")) != expected_counter:
        raise SystemExit(1)

expected_deadzone = float(deadzone)
actual_deadzone = operator.get("deadzone_fraction_of_delta")

if method == "scw":
    if actual_deadzone is None:
        raise SystemExit(1)

    if not math.isclose(
        float(actual_deadzone),
        expected_deadzone,
        rel_tol=0.0,
        abs_tol=1e-12,
    ):
        raise SystemExit(1)

if manifest.get("analysis_script_sha256") != sha256_file(analysis_script):
    raise SystemExit(1)

if manifest.get("base_analysis_script_sha256") != sha256_file(base_analysis_script):
    raise SystemExit(1)

if manifest.get("fidelity_json_sha256") != sha256_file(fidelity_json):
    raise SystemExit(1)

raise SystemExit(0)
PY
}


verify_condition_output() {
    local out_dir=$1
    local condition_name=$2
    local run_dir=$3
    local phase=$4
    local method=$5
    local state_bits=$6
    local residual_bits=$7
    local counter_bits=$8
    local deadzone=$9
    local fidelity_json=${10}

    if ! condition_matches_request \
        "${out_dir}" \
        "${condition_name}" \
        "${run_dir}" \
        "${phase}" \
        "${method}" \
        "${state_bits}" \
        "${residual_bits}" \
        "${counter_bits}" \
        "${deadzone}" \
        "${fidelity_json}"
    then
        fatal "condition failed validation or is stale: ${condition_name}"
    fi

    log "Verified condition: ${condition_name}"
}


submit_condition() {
    local run_dir=$1
    local phase=$2
    local condition_name=$3
    local method=$4
    local state_bits=$5
    local residual_bits=$6
    local counter_bits=$7
    local deadzone=$8
    local out_root=$9
    local fidelity_json=${10}

    local out_dir="${out_root}/${condition_name}"
    local complete_flag="${out_dir}/recurrent_memory_complete.flag"

    mkdir -p "${out_dir}"

    if condition_matches_request \
        "${out_dir}" \
        "${condition_name}" \
        "${run_dir}" \
        "${phase}" \
        "${method}" \
        "${state_bits}" \
        "${residual_bits}" \
        "${counter_bits}" \
        "${deadzone}" \
        "${fidelity_json}"
    then
        log "SKIP current completed condition: ${condition_name}"
        return 0
    fi

    backup_completion_flag "${complete_flag}"

    local job_id

    job_id=$(
        sbatch \
            --parsable \
            --job-name="rm_${condition_name}" \
            "${GPU_WORKER}" \
            "${run_dir}" \
            "${phase}" \
            "${condition_name}" \
            "${method}" \
            "${state_bits}" \
            "${residual_bits}" \
            "${counter_bits}" \
            "${deadzone}" \
            "${out_dir}" \
            "${fidelity_json}"
    )

    [[ -n "${job_id}" ]] || fatal "sbatch returned no job ID for ${condition_name}"

    JOB_IDS+=("${job_id}")

    log "Submitted ${condition_name}: job ${job_id}"
}


submit_gate_after_current_jobs() {
    local next_mode=$1
    local job_name=$2

    local gate_id

    if (( ${#JOB_IDS[@]} == 0 )); then
        gate_id=$(
            sbatch \
                --parsable \
                --job-name="${job_name}" \
                "${PIPELINE_SCRIPT}" \
                "${next_mode}"
        )
    else
        local dependency

        dependency=$(
            IFS=:
            echo "${JOB_IDS[*]}"
        )

        gate_id=$(
            sbatch \
                --parsable \
                --job-name="${job_name}" \
                --dependency="afterany:${dependency}" \
                "${PIPELINE_SCRIPT}" \
                "${next_mode}"
        )
    fi

    [[ -n "${gate_id}" ]] || fatal "failed to submit gate ${next_mode}"

    log "Submitted gate ${next_mode}: job ${gate_id}"
}


