run_smoke_validation() {
    verify_condition_output \
        "${V4_SMOKE_OUT}" \
        "V4_det_B4" \
        "${V4_RUN}" \
        "VANILLA" \
        "deterministic" \
        "4" \
        "-1" \
        "-1" \
        "0" \
        "${V4_FIDELITY}"

    backup_completion_flag "${V4_SMOKE_FLAG}"

    python \
        "${SMOKE_SCRIPT}" \
        --reference-dir "${V4_NATIVE_REFERENCE}" \
        --new-dir "${V4_SMOKE_OUT}" \
        --out-dir "${V4_SMOKE_CHECK}" \
        --absolute-tolerance 1e-6

    require_file "${V4_SMOKE_FLAG}"

    python - "${V4_SMOKE_CHECK}/recurrent_memory_smoke_validation.json" <<'PY'
import json
import sys

path = sys.argv[1]

with open(path, "r", encoding="utf-8") as handle:
    payload = json.load(handle)

if payload.get("passed") is not True:
    raise SystemExit(
        "smoke validation JSON does not report passed=true"
    )

print("[SMOKE] validation passed")
PY

    log "Smoke validation passed"
}


