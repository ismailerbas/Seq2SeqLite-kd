    log "Both lifetime analyses verified"
}


aggregate_is_current() {
    local flag="${STUDY_OUT_DIR}/recurrent_memory_study_complete.flag"
    local study_json="${STUDY_OUT_DIR}/recurrent_memory_study.json"

    if [[ ! -f "${flag}" || ! -f "${study_json}" ]]; then
        return 1
    fi

    local required_outputs=(
        "${STUDY_OUT_DIR}/method_sweep.csv"
        "${STUDY_OUT_DIR}/equal_storage_comparison.csv"
        "${STUDY_OUT_DIR}/margin_decomposition.csv"
        "${STUDY_OUT_DIR}/margin_histograms.csv"
        "${STUDY_OUT_DIR}/margin_joint_gate_candidate.csv"
        "${STUDY_OUT_DIR}/lifetime_binned_excess_error.csv"
    )

    local path

    for path in "${required_outputs[@]}"; do
        if [[ ! -f "${path}" ]]; then
            return 1
        fi
    done

    python - "${study_json}" "${AGGREGATE_SCRIPT}" <<'PY'
import hashlib
import json
import os
import sys

study_json, aggregate_script = sys.argv[1:]


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        while True:
            block = handle.read(1024 * 1024)
            if not block:
                break
            digest.update(block)
    return digest.hexdigest()


with open(study_json, "r", encoding="utf-8") as handle:
    payload = json.load(handle)

if payload.get("passed") is not True:
    raise SystemExit(1)

if payload.get("analysis_script_sha256") != sha256_file(aggregate_script):
    raise SystemExit(1)

input_files = payload.get("input_files")

if not isinstance(input_files, dict) or not input_files:
    raise SystemExit(1)

for path, expected_hash in input_files.items():
    if not os.path.isfile(path):
        raise SystemExit(1)

    if sha256_file(path) != expected_hash:
        raise SystemExit(1)

raise SystemExit(0)
PY
}


