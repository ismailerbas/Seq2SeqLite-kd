lifetime_is_current() {
    local out_dir=$1
    local reference_name=$2
    local condition_name=$3
    local reference_manifest=$4
    local condition_manifest=$5

    local flag="${out_dir}/lifetime_binned_excess_error_complete.flag"
    local json_path="${out_dir}/lifetime_binned_excess_error.json"
    local csv_path="${out_dir}/lifetime_binned_excess_error.csv"

    if [[ ! -f "${flag}" || ! -f "${json_path}" || ! -f "${csv_path}" ]]; then
        return 1
    fi

    python - \
        "${json_path}" \
        "${reference_name}" \
        "${condition_name}" \
        "${reference_manifest}" \
        "${condition_manifest}" \
        "${LIFETIME_SCRIPT}" <<'PY'
import hashlib
import json
import sys

(
    json_path,
    reference_name,
    condition_name,
    reference_manifest,
    condition_manifest,
    lifetime_script,
) = sys.argv[1:]


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        while True:
            block = handle.read(1024 * 1024)
            if not block:
                break
            digest.update(block)
    return digest.hexdigest()


with open(json_path, "r", encoding="utf-8") as handle:
    payload = json.load(handle)

if payload.get("reference_name") != reference_name:
    raise SystemExit(1)

if payload.get("condition_name") != condition_name:
    raise SystemExit(1)

if payload.get("same_checkpoint_required") is not True:
    raise SystemExit(1)

if payload.get("reference_manifest_sha256") != sha256_file(reference_manifest):
    raise SystemExit(1)

if payload.get("condition_manifest_sha256") != sha256_file(condition_manifest):
    raise SystemExit(1)

if payload.get("analysis_script_sha256") != sha256_file(lifetime_script):
    raise SystemExit(1)

raise SystemExit(0)
PY
}


submit_lifetime_job() {
    local reference_name=$1
    local condition_name=$2
    local reference_dir=$3
    local condition_dir=$4
    local out_dir=$5

    local reference_npz="${reference_dir}/recurrent_memory_per_sequence.npz"
    local condition_npz="${condition_dir}/recurrent_memory_per_sequence.npz"
    local reference_manifest="${reference_dir}/recurrent_memory_manifest.json"
    local condition_manifest="${condition_dir}/recurrent_memory_manifest.json"

    require_file "${reference_npz}"
    require_file "${condition_npz}"
    require_file "${reference_manifest}"
    require_file "${condition_manifest}"

    mkdir -p "${out_dir}"

    if lifetime_is_current \
        "${out_dir}" \
        "${reference_name}" \
        "${condition_name}" \
        "${reference_manifest}" \
        "${condition_manifest}"
    then
        log "SKIP current lifetime analysis: ${condition_name} vs ${reference_name}"
        return 0
    fi

    backup_completion_flag "${out_dir}/lifetime_binned_excess_error_complete.flag"

    local job_id

    job_id=$(
        sbatch \
            --parsable \
            --job-name="rm_life_${condition_name}" \
            "${CPU_WORKER}" \
            lifetime \
            "${reference_npz}" \
            "${condition_npz}" \
            "${reference_manifest}" \
            "${condition_manifest}" \
            "${reference_name}" \
            "${condition_name}" \
            "${out_dir}"
    )

    [[ -n "${job_id}" ]] || fatal "failed to submit lifetime analysis ${condition_name}"

    JOB_IDS+=("${job_id}")

    log "Submitted lifetime analysis ${condition_name} vs ${reference_name}: job ${job_id}"
}


