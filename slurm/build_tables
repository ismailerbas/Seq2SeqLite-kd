#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu


# ============================================================================
# build_tables — reads test_sdf_metrics.json files already produced by
# eval_teacher_sdf, eval_ptq_sdf, and eval_student_vanilla_sdf, then
# constructs Tables 1, 2, 3, and 4 from the paper and writes:
#
#   tables/table1_teacher.tex
#   tables/table2_ptq.tex
#   tables/table3_student.tex
#   tables/table4_student_hybrid.tex
#
# Only vanilla_kd_* directories are processed for Tables 3 and 4.
# Table 3 = uniform quantization (bits_kernel == bits_recurrent).
# Table 4 = hybrid quantization  (bits_kernel != bits_recurrent).
#
# No GPU required.  No TF model loading.  Pure Python / JSON / numpy.
# Wall time 30 min is generous; typical runtime is under 60 seconds.
#
# Positional args:
#   $1  OVERWRITE   (optional, pass "overwrite" to re-run even if .tex exist)
#
# Examples:
#   sbatch --job-name=build_tables slurm/build_tables
#   sbatch --job-name=build_tables slurm/build_tables overwrite
# ============================================================================

OVERWRITE_ARG=""
if [ "${1}" = "overwrite" ]; then
    OVERWRITE_ARG="--overwrite"
fi

# ============================================================================
# STEP 1 — modules
# ============================================================================
module purge
module load gcc/9.3.0/1

# ============================================================================
# STEP 2 — activate conda
# ============================================================================
eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
conda activate tf210_qkeras

# ============================================================================
# STEP 3 — THE FIX
# ============================================================================
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

# ============================================================================
# STEP 4 — env settings (no GPU needed but keep TF quiet)
# ============================================================================
export CUDA_VISIBLE_DEVICES=""
export TF_CPP_MIN_LOG_LEVEL=3
export TF_ENABLE_ONEDNN_OPTS=0
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# --- Paths ---
SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"
RESULTS_PATH="${SCRATCH_BASE}/nmi"
SCRIPT_DIR="/gpfs/u/scratch/HBNN/HBNNrbss/nmi"
OUT_DIR="${SCRIPT_DIR}/tables"

# --- Scratch / cache dirs ---
export TMPDIR="${SCRATCH_BASE}/tmp_pip"
export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"
export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"
export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"
export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}" "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"
mkdir -p "${OUT_DIR}"

# --- Log ---
echo "============================================================"
echo "BUILD TABLES — Tables 1, 2, 3, 4"
echo "Reading test_sdf_metrics.json from ${RESULTS_PATH}"
echo "Writing .tex files to ${OUT_DIR}"
echo "Only vanilla_kd_* dirs processed for Tables 3 and 4"
echo "============================================================"
echo "SLURM JOB ID        : ${SLURM_JOBID}"
echo "SLURM JOB NAME      : ${SLURM_JOB_NAME}"
echo "NODE                : $(hostname)"
echo "RESULTS PATH        : ${RESULTS_PATH}"
echo "SCRIPT DIR          : ${SCRIPT_DIR}"
echo "OUT DIR             : ${OUT_DIR}"
echo "OVERWRITE ARG       : ${OVERWRITE_ARG}"
echo "PYTHON              : $(which python)"
echo "NUMPY VERSION       : $(python -c 'import numpy as np; print(np.__version__)' 2>/dev/null)"
echo "============================================================"

if [ ! -f "${SCRIPT_DIR}/tables/build_tables.py" ]; then
    echo "FATAL: tables/build_tables.py not found in ${SCRIPT_DIR}/tables/"
    exit 1
fi
echo "build_tables.py found."
echo "Starting table construction..."
echo "============================================================"

# ============================================================================
# Launch (foreground — no resubmission needed, runs in under 60 seconds)
# ============================================================================
python "${SCRIPT_DIR}/tables/build_tables.py" \
    --results-dir "${RESULTS_PATH}" \
    --out-dir     "${OUT_DIR}"

EXIT_CODE=$?

echo "============================================================"
echo "Exit Code: ${EXIT_CODE}"
if [ ${EXIT_CODE} -eq 0 ]; then
    echo "Tables built successfully."
    echo "Output files:"
    echo "  ${OUT_DIR}/table1_teacher.tex"
    echo "  ${OUT_DIR}/table2_ptq.tex"
    echo "  ${OUT_DIR}/table3_student.tex"
    echo "  ${OUT_DIR}/table4_student_hybrid.tex"
    echo "Line counts:"
    wc -l "${OUT_DIR}/table1_teacher.tex" 2>/dev/null
    wc -l "${OUT_DIR}/table2_ptq.tex"     2>/dev/null
    wc -l "${OUT_DIR}/table3_student.tex" 2>/dev/null
    wc -l "${OUT_DIR}/table4_student_hybrid.tex" 2>/dev/null
else
    echo "FAILED (exit code: ${EXIT_CODE})"
    echo "Check: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
    echo "  grep -i 'error\|traceback\|valueerror\|assertionerror' \\"
    echo "       slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err | head -40"
fi
echo "============================================================"
echo "Log files:"
echo "  Out: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"
echo "  Err: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
echo "============================================================"

exit ${EXIT_CODE}