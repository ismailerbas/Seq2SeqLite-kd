submit_worker() {
    local condition="$1"
    local seed="$2"
    local resume_mode="$3"
    local job_id
    local job_name="mem_${condition}_s${seed}"

    if [[ "${resume_mode}" == "resume" ]]; then
        log "Submitting resume: condition=${condition} seed=${seed}"
        job_id=$(sbatch --parsable --job-name="${job_name}" "${WORKER}" "${condition}" "${seed}" --resume)
    else
        log "Submitting fresh: condition=${condition} seed=${seed}"
        job_id=$(sbatch --parsable --job-name="${job_name}" "${WORKER}" "${condition}" "${seed}")
    fi
    [[ -n "${job_id}" ]] || fatal "sbatch returned an empty job ID for ${condition} seed ${seed}"
    SUBMITTED_JOB_IDS+=("${job_id}")
    log "Submitted ${condition} seed ${seed} as job ${job_id}"
}

submit_gate_after_jobs() {
    local dependency
    local old_ifs="${IFS}"
    IFS=:
    dependency="${SUBMITTED_JOB_IDS[*]}"
    IFS="${old_ifs}"
    [[ -n "${dependency}" ]] || fatal "cannot submit gate with empty dependency"
    local gate_id
    gate_id=$(sbatch \
        --parsable \
        --dependency="afterany:${dependency}" \
        --job-name="mem_train_gate" \
        "${PIPELINE_SCRIPT}" \
        gate)
    [[ -n "${gate_id}" ]] || fatal "failed to submit dependent training gate"
    log "Submitted dependent gate job ${gate_id} after ${dependency}"
}

run_bootstrap() {
    SUBMITTED_JOB_IDS=()
    for condition in "${CONDITIONS[@]}"; do
        for seed in "${SEEDS[@]}"; do
            local final_flag
            local provenance
            local resume_state
            local training_flag
            final_flag="$(completion_flag_for "${condition}" "${seed}")"
            provenance="$(provenance_for "${condition}" "${seed}")"
            resume_state="$(resume_state_for "${condition}" "${seed}")"
            training_flag="$(training_flag_for "${condition}" "${seed}")"

            if [[ -f "${final_flag}" ]]; then
                verify_completed_condition "${condition}" "${seed}"
                log "Already complete and current: ${condition} seed ${seed}"
                continue
            fi

            if [[ -f "${resume_state}" || -f "${training_flag}" ]]; then
                verify_provenance "${condition}" "${seed}"
                submit_worker "${condition}" "${seed}" resume
                continue
            fi

            if [[ -f "${provenance}" ]]; then
                verify_provenance "${condition}" "${seed}"
                fatal "${condition} seed ${seed} has provenance but no completion or resumable state; inspect its failed SLURM log before restarting"
            fi

            submit_worker "${condition}" "${seed}" fresh
        done
    done

    if [[ "${#SUBMITTED_JOB_IDS[@]}" -gt 0 ]]; then
        submit_gate_after_jobs
        log "Bootstrap submission complete"
        return
    fi

    log "No training workers were required; running gate immediately"
    run_gate
}

run_gate() {
    SUBMITTED_JOB_IDS=()
    local hard_failure=0

    for condition in "${CONDITIONS[@]}"; do
        for seed in "${SEEDS[@]}"; do
            local final_flag
            local provenance
            local resume_state
            local training_flag
            final_flag="$(completion_flag_for "${condition}" "${seed}")"
            provenance="$(provenance_for "${condition}" "${seed}")"
            resume_state="$(resume_state_for "${condition}" "${seed}")"
            training_flag="$(training_flag_for "${condition}" "${seed}")"

            if [[ -f "${final_flag}" ]]; then
                verify_completed_condition "${condition}" "${seed}"
                log "Verified complete: ${condition} seed ${seed}"
                continue
            fi

            if [[ -f "${resume_state}" || -f "${training_flag}" ]]; then
                verify_provenance "${condition}" "${seed}"
                submit_worker "${condition}" "${seed}" resume
                continue
            fi

            if [[ -f "${provenance}" ]]; then
                log "HARD FAILURE: ${condition} seed ${seed} has no resumable checkpoint"
                hard_failure=1
            else
                log "HARD FAILURE: ${condition} seed ${seed} never created run provenance"
                hard_failure=1
            fi
        done
    done

    if [[ "${hard_failure}" -ne 0 ]]; then
        fatal "at least one training condition failed before a safe resume point; no downstream aggregation was submitted"
    fi

    if [[ "${#SUBMITTED_JOB_IDS[@]}" -gt 0 ]]; then
        submit_gate_after_jobs
        log "Resumable conditions were resubmitted; aggregation remains blocked"
        return
    fi

    log "All 12 training conditions are complete and current"
    log "Running aggregate analysis inside this dependent SLURM gate"

    module purge
    module load gcc/9.3.0/1
