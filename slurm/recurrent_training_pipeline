b6 = native(6)
b4_weights = campaign.export_model_raw_weights(b4, "b4")
b6_weights = campaign.export_model_raw_weights(b6, "b6")
for key in sorted(b4_weights):
    if not np.array_equal(b4_weights[key], b6_weights[key]):
        raise RuntimeError(f"B4/B6 matched initialization failed for {key}")

args = SimpleNamespace(**base)

tf.keras.utils.set_random_seed(42)
r2_reference = campaign.common.build_student(135, 3, 32, 4, 4, 4, 4, 4)
r2 = campaign.R2StudentModel(args)
campaign.build_custom_children(r2, args)
r2_output = r2([dummy, dummy], training=False, operator_mode="r2")
if tuple(r2_output.shape) != (1, 135, 3):
    raise RuntimeError(f"r2 smoke output shape mismatch: {tuple(r2_output.shape)}")
campaign.transfer_reference_weights(r2_reference, r2)
r2_weights = campaign.export_model_raw_weights(r2, "r2")
for key in sorted(b4_weights):
    if not np.array_equal(b4_weights[key], r2_weights[key]):
        raise RuntimeError(f"B4/R2 matched initialization failed for {key}")

tf.keras.utils.set_random_seed(42)
scw_reference = campaign.common.build_student(135, 3, 32, 4, 4, 4, 4, 4)
scw = campaign.common.SCWStudentModel(
    seq_len=135,
    n_out=3,
    student_units=32,
    bits_kernel=4,
