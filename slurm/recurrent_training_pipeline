#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=2
#SBATCH --time=01:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu

set -euo pipefail

PROJECT_DIR="/gpfs/u/home/HBNN/HBNNrbss/scratch/nmi"
DATA_PATH="/gpfs/u/scratch/HBNN/HBNNrbss/nmi"
CAMPAIGN_ROOT="${PROJECT_DIR}/recurrent_training_campaign"
WORKER="${PROJECT_DIR}/studentvanilla_memory_train"
TRAINING_SCRIPT="${PROJECT_DIR}/train_student_vanilla_kd_memory_campaign.py"
AGGREGATE_SCRIPT="${PROJECT_DIR}/eval/build_recurrent_training_campaign.py"
PIPELINE_SCRIPT="${PROJECT_DIR}/recurrent_training_pipeline"
TEACHER_WEIGHTS="${DATA_PATH}/teacher_best.weights.h5"
TEACHER_CACHE="${DATA_PATH}/teacherPred_vanillaKD_L1351600000.npy"
CAMPAIGN_SPEC="${CAMPAIGN_ROOT}/campaign_spec.json"
MODE="${1:-bootstrap}"

CONDITIONS=(b4 b6 r2 scw_k2)
SEEDS=(42 43 44)

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

fatal() {
    log "FATAL: $*"
    exit 1
}

require_file() {
    local path="$1"
    [[ -f "${path}" ]] || fatal "required file does not exist: ${path}"
}

require_dir() {
    local path="$1"
    [[ -d "${path}" ]] || fatal "required directory does not exist: ${path}"
}

sha256_file() {
    sha256sum "$1" | awk '{print $1}'
}

job_dir_for() {
    local condition="$1"
    local seed="$2"
    printf '%s/results/vanilla_memory_%s_seed%s' "${CAMPAIGN_ROOT}" "${condition}" "${seed}"
}

completion_flag_for() {
    local condition="$1"
    local seed="$2"
    printf '%s/campaign_training_complete.flag' "$(job_dir_for "${condition}" "${seed}")"
}

resume_state_for() {
    local condition="$1"
    local seed="$2"
    printf '%s/resume_state.json' "$(job_dir_for "${condition}" "${seed}")"
}

training_flag_for() {
    local condition="$1"
    local seed="$2"
    printf '%s/training_complete.flag' "$(job_dir_for "${condition}" "${seed}")"
}

provenance_for() {
    local condition="$1"
    local seed="$2"
    printf '%s/run_provenance.json' "$(job_dir_for "${condition}" "${seed}")"
}

manifest_for() {
    local condition="$1"
    local seed="$2"
    printf '%s/training_manifest.json' "$(job_dir_for "${condition}" "${seed}")"
}

preflight() {
    log "Running recurrent training campaign preflight for mode=${MODE}"
    require_dir "${PROJECT_DIR}"
    require_dir "${DATA_PATH}"
    cd "${PROJECT_DIR}"
    require_file "${WORKER}"
    require_file "${TRAINING_SCRIPT}"
    require_file "${AGGREGATE_SCRIPT}"
    require_file "${PIPELINE_SCRIPT}"
    require_file "${PROJECT_DIR}/train_student_vanilla_kd.py"
    require_file "${PROJECT_DIR}/train_student_vanilla_kd_scw.py"
    require_file "${PROJECT_DIR}/train_student_memoq.py"
    require_file "${TEACHER_WEIGHTS}"
    require_file "${TEACHER_CACHE}"

    for file in \
        "${WORKER}" \
        "${TRAINING_SCRIPT}" \
        "${AGGREGATE_SCRIPT}" \
        "${PIPELINE_SCRIPT}" \
        "${PROJECT_DIR}/train_student_vanilla_kd_scw.py"; do
        if grep -q $'\r' "${file}"; then
            fatal "DOS CRLF line endings detected: ${file}"
        fi
    done

    bash -n "${WORKER}"
    bash -n "${PIPELINE_SCRIPT}"

    module purge
    module load gcc/9.3.0/1
    eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
    conda activate tf210_qkeras

    python -m py_compile "${TRAINING_SCRIPT}"
    python -m py_compile "${AGGREGATE_SCRIPT}"
    python -m py_compile "${PROJECT_DIR}/train_student_vanilla_kd.py"
    python -m py_compile "${PROJECT_DIR}/train_student_vanilla_kd_scw.py"
    python -m py_compile "${PROJECT_DIR}/train_student_memoq.py"

    python - "${TEACHER_CACHE}" <<'PY_CACHE_CHECK'
import sys
import numpy as np

path = sys.argv[1]
cache = np.load(path, mmap_mode="r")
if cache.shape != (1600000, 135, 3):
    raise SystemExit(f"teacher cache shape mismatch: {cache.shape}")
if cache.dtype != np.float32:
    raise SystemExit(f"teacher cache dtype mismatch: {cache.dtype}")
print("TEACHER_CACHE_PASSED")
PY_CACHE_CHECK

    python - <<'PY_MODEL_SMOKE'
