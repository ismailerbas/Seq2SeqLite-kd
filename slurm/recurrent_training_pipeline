submit_worker() {
    local condition="$1"
    local seed="$2"
    local resume_mode="$3"
    local raw_job_id
    local job_id
    local job_name="mem_${condition}_s${seed}"

    if [[ "${resume_mode}" == "resume" ]]; then
        log "Submitting resume: condition=${condition} seed=${seed}"

        raw_job_id=$(
            sbatch \
                --parsable \
                --job-name="${job_name}" \
                "${WORKER}" \
                "${condition}" \
                "${seed}" \
                --resume
        )

    elif [[ "${resume_mode}" == "fresh" ]]; then
        log "Submitting fresh: condition=${condition} seed=${seed}"

        raw_job_id=$(
            sbatch \
                --parsable \
                --job-name="${job_name}" \
                "${WORKER}" \
                "${condition}" \
                "${seed}"
        )

    else
        fatal "unsupported worker submission mode: ${resume_mode}"
    fi

    job_id="${raw_job_id%%;*}"

    if [[ ! "${job_id}" =~ ^[0-9]+$ ]]; then
        fatal "invalid sbatch job ID for ${condition} seed ${seed}: ${raw_job_id}"
    fi

    SUBMITTED_JOB_IDS+=(
        "${job_id}"
    )

    log "Submitted ${condition} seed ${seed} as job ${job_id}"
}

submit_gate_after_jobs() {
    local dependency
    local old_ifs="${IFS}"
    local raw_gate_id
    local gate_id

    IFS=:
    dependency="${SUBMITTED_JOB_IDS[*]}"
    IFS="${old_ifs}"

    [[ -n "${dependency}" ]] || \
        fatal "cannot submit gate with empty dependency"

    raw_gate_id=$(
        sbatch \
            --parsable \
            --dependency="afterany:${dependency}" \
            --job-name="mem_train_gate" \
            "${PIPELINE_SCRIPT}" \
            gate
    )

    gate_id="${raw_gate_id%%;*}"

    if [[ ! "${gate_id}" =~ ^[0-9]+$ ]]; then
        fatal "invalid dependent gate job ID: ${raw_gate_id}"
    fi

    log "Submitted dependent gate job ${gate_id} after ${dependency}"
}

run_bootstrap() {
    SUBMITTED_JOB_IDS=()

    local -a plan_conditions=()
    local -a plan_seeds=()
    local -a plan_modes=()

    local condition
    local seed
    local final_flag
    local provenance
    local resume_state
    local training_flag
    local resume_request
    local index

    for condition in "${CONDITIONS[@]}"; do
        for seed in "${SEEDS[@]}"; do
            final_flag="$(
                completion_flag_for \
                    "${condition}" \
                    "${seed}"
            )"

            provenance="$(
                provenance_for \
                    "${condition}" \
                    "${seed}"
            )"

            resume_state="$(
                resume_state_for \
                    "${condition}" \
                    "${seed}"
            )"

            training_flag="$(
                training_flag_for \
                    "${condition}" \
                    "${seed}"
            )"

            resume_request="$(
                resume_request_flag_for \
                    "${condition}" \
                    "${seed}"
            )"

            if [[ -f "${final_flag}" ]]; then
                verify_completed_condition \
                    "${condition}" \
                    "${seed}"

                log "Already complete and current: ${condition} seed ${seed}"

                continue
            fi

            if [[ -f "${resume_request}" ]]; then
                if [[ ! -f "${resume_state}" && ! -f "${training_flag}" ]]; then
                    fatal "${condition} seed ${seed} has a controlled-resume marker but no resumable state"
                fi

                verify_provenance \
                    "${condition}" \
                    "${seed}"

                plan_conditions+=(
                    "${condition}"
                )

                plan_seeds+=(
                    "${seed}"
                )

                plan_modes+=(
                    "resume"
                )

                continue
            fi

            if [[ -f "${resume_state}" || -f "${training_flag}" ]]; then
                verify_provenance \
                    "${condition}" \
                    "${seed}"

                fatal "${condition} seed ${seed} has resumable state but no controlled walltime resume marker; inspect its previous SLURM log before restarting"
            fi

            if [[ -f "${provenance}" ]]; then
                verify_provenance \
                    "${condition}" \
                    "${seed}"

                fatal "${condition} seed ${seed} has provenance but no completion or controlled resumable state; inspect its failed SLURM log before restarting"
            fi

            plan_conditions+=(
                "${condition}"
            )

            plan_seeds+=(
                "${seed}"
            )

            plan_modes+=(
                "fresh"
            )
        done
    done

    for index in "${!plan_conditions[@]}"; do
        submit_worker \
            "${plan_conditions[${index}]}" \
            "${plan_seeds[${index}]}" \
            "${plan_modes[${index}]}"
    done

    if [[ "${#SUBMITTED_JOB_IDS[@]}" -gt 0 ]]; then
        submit_gate_after_jobs
        log "Bootstrap submission complete"
        return
    fi

    log "No training workers were required; running gate immediately"

    run_gate
}

run_gate() {
    SUBMITTED_JOB_IDS=()

    local -a plan_conditions=()
    local -a plan_seeds=()

    local hard_failure=0
    local condition
    local seed
    local final_flag
    local provenance
    local resume_state
    local training_flag
    local resume_request
    local index

    for condition in "${CONDITIONS[@]}"; do
        for seed in "${SEEDS[@]}"; do
            final_flag="$(
                completion_flag_for \
                    "${condition}" \
                    "${seed}"
            )"

            provenance="$(
                provenance_for \
                    "${condition}" \
                    "${seed}"
            )"

            resume_state="$(
                resume_state_for \
                    "${condition}" \
                    "${seed}"
            )"

            training_flag="$(
                training_flag_for \
                    "${condition}" \
                    "${seed}"
            )"

            resume_request="$(
                resume_request_flag_for \
                    "${condition}" \
                    "${seed}"
            )"

            if [[ -f "${final_flag}" ]]; then
                verify_completed_condition \
                    "${condition}" \
                    "${seed}"

                log "Verified complete: ${condition} seed ${seed}"

                continue
            fi

            if [[ -f "${resume_request}" ]]; then
                if [[ ! -f "${resume_state}" && ! -f "${training_flag}" ]]; then
                    log "HARD FAILURE: ${condition} seed ${seed} has a controlled-resume marker but no resumable state"
                    hard_failure=1
                    continue
                fi

                verify_provenance \
                    "${condition}" \
                    "${seed}"

                plan_conditions+=(
                    "${condition}"
                )

                plan_seeds+=(
                    "${seed}"
                )

                continue
            fi

            if [[ -f "${resume_state}" || -f "${training_flag}" ]]; then
                verify_provenance \
                    "${condition}" \
                    "${seed}"

                log "HARD FAILURE: ${condition} seed ${seed} has resumable state but no controlled walltime resume marker"
                hard_failure=1
                continue
            fi

            if [[ -f "${provenance}" ]]; then
                log "HARD FAILURE: ${condition} seed ${seed} has provenance but no completion or controlled resumable state"
                hard_failure=1
            else
                log "HARD FAILURE: ${condition} seed ${seed} never created run provenance"
                hard_failure=1
            fi
        done
    done

    if [[ "${hard_failure}" -ne 0 ]]; then
        fatal "at least one training condition failed outside the controlled walltime-resume path; no continuation jobs and no downstream aggregation were submitted"
    fi

    for index in "${!plan_conditions[@]}"; do
        submit_worker \
            "${plan_conditions[${index}]}" \
            "${plan_seeds[${index}]}" \
            resume
    done

    if [[ "${#SUBMITTED_JOB_IDS[@]}" -gt 0 ]]; then
        submit_gate_after_jobs

        log "Controlled walltime continuations were submitted; aggregation remains blocked"

        return
    fi

    log "All 12 training conditions are complete and current"
    log "Running aggregate analysis inside this dependent SLURM gate"

    module purge
    module load gcc/9.3.0/1

    eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
    conda activate tf210_qkeras

    python "${AGGREGATE_SCRIPT}" \
        --campaign-root "${CAMPAIGN_ROOT}" \
        --training-script "${TRAINING_SCRIPT}"

    require_file "${CAMPAIGN_ROOT}/aggregate/trained_memory_campaign_summary.json"
    require_file "${CAMPAIGN_ROOT}/aggregate/trained_memory_seed_metrics.csv"
    require_file "${CAMPAIGN_ROOT}/aggregate/trained_memory_campaign_complete.flag"

    log "Training campaign aggregate passed"
    log "Summary: ${CAMPAIGN_ROOT}/aggregate/trained_memory_campaign_summary.json"
    log "CSV: ${CAMPAIGN_ROOT}/aggregate/trained_memory_seed_metrics.csv"
}

