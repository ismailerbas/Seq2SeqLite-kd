    current_baseline_sha="$(sha256_file "${PROJECT_DIR}/train_student_vanilla_kd.py")"
    current_scw_sha="$(sha256_file "${PROJECT_DIR}/train_student_vanilla_kd_scw.py")"
    current_teacher_sha="$(sha256_file "${TEACHER_WEIGHTS}")"

    python - \
        "${provenance}" \
        "${condition}" \
        "${seed}" \
        "${current_training_sha}" \
        "${current_baseline_sha}" \
        "${current_scw_sha}" \
        "${current_teacher_sha}" <<'PY'
