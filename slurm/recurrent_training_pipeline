verify_completed_condition() {
    local condition="$1"
    local seed="$2"
    local dir
    dir="$(job_dir_for "${condition}" "${seed}")"
    require_file "${dir}/campaign_training_complete.flag"
    require_file "${dir}/training_complete.flag"
    require_file "${dir}/training_manifest.json"
    require_file "${dir}/test_metrics.json"
    require_file "${dir}/test_per_sequence.npz"
    require_file "${dir}/student_best.weights.h5"
    require_file "${dir}/student_final.weights.h5"
    require_file "${dir}/initial_weights.npz"
    verify_provenance "${condition}" "${seed}"

    local current_training_sha
    current_training_sha="$(sha256_file "${TRAINING_SCRIPT}")"
    python - \
        "${dir}/training_manifest.json" \
        "${condition}" \
        "${seed}" \
        "${current_training_sha}" <<'PY'
