import numpy as np
import tensorflow as tf

import train_student_vanilla_kd_memory_campaign as campaign

base = dict(
    seq_len=135,
    n_out=3,
    student_units=32,
    bits_kernel=4,
    bits_recurrent=4,
    bits_bias=4,
    bits_activation=4,
    bits_state=4,
    q_alpha=1.0,
    residual_bits=2,
)
dummy = tf.zeros((1, 135, 1), tf.float32)


def native(state_bits):
    tf.keras.utils.set_random_seed(42)
    model = campaign.common.build_student(135, 3, 32, 4, 4, 4, 4, state_bits)
    output = model([dummy, dummy], training=False)
    if tuple(output.shape) != (1, 135, 3):
        raise RuntimeError(
            f"native B{state_bits} smoke output shape mismatch: {tuple(output.shape)}"
        )
    return model


