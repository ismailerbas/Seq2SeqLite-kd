def require_finite_output(
    label,
    output,
):
    output_array = np.asarray(
        output.numpy(),
        dtype=np.float32,
    )

    if (
        output_array.shape
        != expected_output_shape
    ):
        raise RuntimeError(
            f"{label} output shape "
            f"mismatch: "
            f"{output_array.shape}"
        )

    if not np.all(
        np.isfinite(
            output_array
        )
    ):
        raise RuntimeError(
            f"{label} produced "
            "non-finite output"
        )


def require_weights_equal(
    reference,
    alternative,
    label,
):
    if (
        set(
            reference
        )
        != set(
            alternative
        )
    ):
        raise RuntimeError(
            f"{label} initial-weight "
            "keys differ"
        )

    for key in sorted(
        reference
    ):
        if not np.array_equal(
            reference[
                key
            ],
            alternative[
                key
            ],
        ):
            max_abs = float(
                np.max(
                    np.abs(
                        reference[
                            key
                        ]
                        - alternative[
                            key
                        ]
                    )
                )
            )

            raise RuntimeError(
                f"{label} matched "
                "initialization failed "
                f"for {key}: "
                f"max_abs={max_abs:.9g}"
            )


def require_deterministic_equivalence(
    reference_model,
    custom_model,
    label,
):
    reference_output = (
        reference_model(
            [
                enc,
                dec,
            ],
            training=False,
        )
    )

    custom_output = (
        custom_model(
            [
                enc,
                dec,
            ],
            training=False,
            operator_mode=(
                "deterministic"
            ),
        )
    )

    reference_array = np.asarray(
        reference_output.numpy(),
        dtype=np.float32,
    )

    custom_array = np.asarray(
        custom_output.numpy(),
        dtype=np.float32,
    )

    difference = np.abs(
        reference_array
        - custom_array
    ).astype(
        np.float64
    )

    max_abs = float(
        np.max(
            difference
        )
    )

    mean_abs = float(
        np.mean(
            difference
        )
    )

    if (
        max_abs
        > 5e-5
        or mean_abs
        > 5e-5
    ):
        raise RuntimeError(
            f"{label} deterministic "
            "equivalence failed: "
            f"max_abs={max_abs:.9g} "
            f"mean_abs={mean_abs:.9g}"
        )


def require_gradient_probe(
    model,
    condition,
):
    with tf.GradientTape() as tape:
        output = (
            campaign.model_forward(
                model,
                condition,
                enc,
                dec,
                True,
            )
        )

        hard_loss = (
            tf.reduce_mean(
                tf.square(
                    output
                    - target
                )
            )
        )

        soft_loss = (
            tf.reduce_mean(
                tf.square(
                    output
                    - teacher
                )
            )
        )

        total_loss = (
            tf.constant(
                0.6,
                tf.float32,
            )
            * soft_loss
            + tf.constant(
                0.4,
                tf.float32,
            )
            * hard_loss
        )

    variables = (
        model
        .trainable_variables
    )

    gradients = tape.gradient(
        total_loss,
        variables,
    )

    if (
        len(
            gradients
        )
        != len(
            variables
        )
    ):
        raise RuntimeError(
            f"{condition} gradient "
            "count mismatch"
        )

    missing = [
        variable.name
        for (
            gradient,
            variable,
        ) in zip(
            gradients,
            variables,
        )
        if gradient is None
    ]

    if missing:
        raise RuntimeError(
            f"{condition} has "
            "disconnected trainable "
            f"variables: {missing}"
        )

    for (
        gradient,
        variable,
    ) in zip(
        gradients,
        variables,
    ):
        finite = bool(
            tf.reduce_all(
                tf.math.is_finite(
                    gradient
                )
            ).numpy()
        )

        if not finite:
            raise RuntimeError(
                f"{condition} produced "
                "non-finite gradient for "
                f"{variable.name}"
            )

    if not bool(
        tf.math.is_finite(
            total_loss
        ).numpy()
    ):
        raise RuntimeError(
            f"{condition} produced "
            "non-finite real-data "
            "smoke loss"
        )


def native_model(
    state_bits,
):
