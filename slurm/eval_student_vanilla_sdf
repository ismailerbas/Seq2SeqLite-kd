#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=06:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu

# ============================================================================
# eval_student_vanilla_sdf — post-hoc SDF metric evaluation for vanilla KD
# student ablations (Table 3).
# Scans /scratch/nmi/results for vanilla_kd* subdirectories that contain
# student_best.weights.h5 and student_args.json.  For each run, loads
# the exact architecture from student_args.json, runs inference on the
# frozen test split (testidx.npy from /scratch/nmi), computes RMSE, R²,
# L2-norm, DTW per SDF channel, and saves test_sdf_metrics.json.
# Also saves test_metrics.json, scatter PNGs, and residual PNG if missing.
#
# No resubmission logic: eval is deterministic and idempotent.
# Wall time 6h is set for a full sweep over all vanilla_kd runs.
#
# Positional args:
#   $1  SEQ_LEN            (optional, default 135)
#   $2  INFER_BATCH        (optional, default 8192)
#   $3  OVERWRITE          (optional, pass "overwrite" to add --overwrite flag)
#
# Examples:
#   sbatch --job-name=eval_student_vanilla_sdf slurm/eval_student_vanilla_sdf
#   sbatch --job-name=eval_student_vanilla_sdf slurm/eval_student_vanilla_sdf 135 8192 overwrite
# ============================================================================

SEQ_LEN=${1:-135}
INFER_BATCH=${2:-8192}
OVERWRITE_ARG=""
if [ "${3}" = "overwrite" ]; then
    OVERWRITE_ARG="--overwrite"
fi

# ============================================================================
# STEP 1 — modules
# ============================================================================
module purge
module load gcc/9.3.0/1

# ============================================================================
# STEP 2 — activate conda
# ============================================================================
eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
conda activate tf210_qkeras

# ============================================================================
# STEP 3 — THE FIX
# ============================================================================
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

# ============================================================================
# STEP 4 — GPU / TF settings
# ============================================================================
export CUDA_VISIBLE_DEVICES=0
export TF_CPP_MIN_LOG_LEVEL=2
export TF_ENABLE_ONEDNN_OPTS=0
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# --- Paths ---
SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"
DATA_PATH="${SCRATCH_BASE}/nmi"
RESULTS_PATH="${SCRATCH_BASE}/nmi/results"
SCRIPT_DIR="/gpfs/u/scratch/HBNN/HBNNrbss/nmi"

# --- Scratch / cache dirs ---
export TMPDIR="${SCRATCH_BASE}/tmp_pip"
export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"
export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"
export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"
export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}" "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

# --- Log ---
echo "============================================================"
echo "EVAL STUDENT VANILLA SDF — Table 3"
echo "Scanning ${RESULTS_PATH} for vanilla_kd* student runs"
echo "============================================================"
echo "SLURM JOB ID        : ${SLURM_JOBID}"
echo "SLURM JOB NAME      : ${SLURM_JOB_NAME}"
echo "NODE                : $(hostname)"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES}"
echo "LD_LIBRARY_PATH     : ${LD_LIBRARY_PATH}"
echo "GPUs available      : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l)"
echo "GPU names           : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
echo "DATA PATH           : ${DATA_PATH}"
echo "RESULTS PATH        : ${RESULTS_PATH}"
echo "SCRIPT DIR          : ${SCRIPT_DIR}"
echo "SEQ LEN             : ${SEQ_LEN}"
echo "INFER BATCH         : ${INFER_BATCH}"
echo "OVERWRITE ARG       : ${OVERWRITE_ARG}"
echo "PYTHON              : $(which python)"
echo "TF VERSION          : $(python -c 'import tensorflow as tf; print(tf.__version__)' 2>/dev/null)"
echo "NUMPY VERSION       : $(python -c 'import numpy as np; print(np.__version__)' 2>/dev/null)"
echo "vanilla_kd runs found under ${RESULTS_PATH}:"
find "${RESULTS_PATH}" -maxdepth 2 -name "student_best.weights.h5" \
    -path "*/vanilla_kd*" 2>/dev/null | while read f; do dirname "$f"; done
echo "============================================================"

# --- GPU sanity check ---
GPU_CHECK=$(python -c "import tensorflow as tf; gpus=tf.config.list_physical_devices('GPU'); print(len(gpus))" 2>/dev/null)
echo "TF physical GPUs found : ${GPU_CHECK}"
if [ "${GPU_CHECK}" = "0" ] || [ -z "${GPU_CHECK}" ]; then
    echo "FATAL: TensorFlow found 0 GPUs."
    echo "Check LD_LIBRARY_PATH includes \$CONDA_PREFIX/lib"
    find "${CONDA_PREFIX}/lib" -name "libcudnn.so.8" 2>/dev/null
    exit 1
fi

if [ ! -f "${SCRIPT_DIR}/eval/eval_student_vanilla_sdf.py" ]; then
    echo "FATAL: eval/eval_student_vanilla_sdf.py not found in ${SCRIPT_DIR}/eval/"
    exit 1
fi

if [ ! -d "${RESULTS_PATH}" ]; then
    echo "FATAL: RESULTS_PATH does not exist: ${RESULTS_PATH}"
    exit 1
fi

echo "eval_student_vanilla_sdf.py found."
echo "Starting evaluation..."
echo "============================================================"

# ============================================================================
# Launch eval (foreground)
# ============================================================================
python "${SCRIPT_DIR}/eval/eval_student_vanilla_sdf.py" \
    --data-dir          "${DATA_PATH}"    \
    --results-dir       "${RESULTS_PATH}" \
    --seq-len           "${SEQ_LEN}"      \
    --n-out             3                 \
    --gate-width-ns     0.09              \
    --infer-batch       "${INFER_BATCH}"  \
    ${OVERWRITE_ARG}

EXIT_CODE=$?

echo "============================================================"
echo "Eval Exit Code: ${EXIT_CODE}"
if [ ${EXIT_CODE} -eq 0 ]; then
    echo "Evaluation completed successfully."
    echo "Results written next to each student_best.weights.h5 under:"
    echo "  ${RESULTS_PATH}"
    echo "  Files per run: test_sdf_metrics.json  test_metrics.json"
    echo "  test_sdf_metrics.json count: $(find "${RESULTS_PATH}" -name "test_sdf_metrics.json" -path "*/vanilla_kd*" 2>/dev/null | wc -l)"
    echo "  PNG count:  $(find "${RESULTS_PATH}" -name "*.png" -path "*/vanilla_kd*" 2>/dev/null | wc -l)"
else
    echo "FAILED (exit code: ${EXIT_CODE})"
    echo "Check: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
    echo "  grep -i 'error\|traceback\|valueerror\|assertionerror' \\"
    echo "       slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err | head -40"
fi
echo "============================================================"
echo "Log files:"
echo "  Out: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"
echo "  Err: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
echo "============================================================"

exit ${EXIT_CODE}