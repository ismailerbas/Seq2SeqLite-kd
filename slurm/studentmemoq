#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu
#SBATCH --signal=B:SIGUSR1@120

set -u


# ==============================================================================
# QKeras-matched primary MemoQ paper trajectory
#
# This launcher is the PRIMARY mechanistic training run.
#
# It is deliberately NOT an ablation:
#
#   P1
#   -> P2A
#   -> P2B
#   -> P2C
#   -> P2D
#   -> P2E
#   -> P2F
#   -> P3
#
# Scientific controls for the primary paper run:
#
#   QKeras-matched recurrent architecture
#   hard_sigmoid
#   implementation=1
#   reset_after=False
#
#   output loss        = MSE
#   quantizer alpha    = 1.0
#   gate curriculum    = true
#   training dither    = false
#   auxiliary losses   = all zero
#
# P2E hardens the candidate activation.
# P2F keeps the candidate hard and hardens recurrent state only.
#
# Auto-resubmission:
#   - SIGUSR1 is delivered 120 s before wall time.
#   - Python checkpoint/resume state from the latest completed epoch is reused.
#   - training_complete.flag prevents resubmission after successful completion.
#
# Usage:
#
#   sbatch --job-name=memoq_paper_main studentmemoq \
#       4 4 4 4 4 32 128 2 135 3 0.09 1024 \
#       /gpfs/u/scratch/HBNN/HBNNrbss/nmi/teacher_best.weights.h5
#
# Resume manually:
#
#   sbatch --job-name=memoq_paper_main studentmemoq \
#       4 4 4 4 4 32 128 2 135 3 0.09 1024 \
#       /gpfs/u/scratch/HBNN/HBNNrbss/nmi/teacher_best.weights.h5 \
#       --resume
# ==============================================================================


BITS_KERNEL=$1
BITS_BIAS=$2
BITS_RECURRENT=$3
BITS_ACTIVATION=$4
BITS_STATE=$5
STUDENT_UNITS=$6
TEACHER_UNITS=$7
TEACHER_LAYERS=$8
SEQ_LEN=$9
N_OUT=${10}
GATE_WIDTH_NS=${11}
BATCH_SIZE=${12}
TEACHER_CKPT=${13}
RESUME_FLAG=${14:-""}


if [ -z "${BITS_KERNEL}" ] || \
   [ -z "${BITS_BIAS}" ] || \
   [ -z "${BITS_RECURRENT}" ] || \
   [ -z "${BITS_ACTIVATION}" ] || \
   [ -z "${BITS_STATE}" ] || \
   [ -z "${STUDENT_UNITS}" ] || \
   [ -z "${TEACHER_UNITS}" ] || \
   [ -z "${TEACHER_LAYERS}" ] || \
   [ -z "${SEQ_LEN}" ] || \
   [ -z "${N_OUT}" ] || \
   [ -z "${GATE_WIDTH_NS}" ] || \
   [ -z "${BATCH_SIZE}" ] || \
   [ -z "${TEACHER_CKPT}" ]; then

    echo "FATAL: Missing required positional arguments."
    echo "Usage:"
    echo "  sbatch studentmemoq BITS_KERNEL BITS_BIAS BITS_RECURRENT BITS_ACTIVATION BITS_STATE STUDENT_UNITS TEACHER_UNITS TEACHER_LAYERS SEQ_LEN N_OUT GATE_WIDTH_NS BATCH_SIZE TEACHER_CKPT [--resume]"
    exit 1
fi


if [ -n "${RESUME_FLAG}" ] && [ "${RESUME_FLAG}" != "--resume" ]; then
    echo "FATAL: optional argument 14 may only be --resume"
    echo "Received: ${RESUME_FLAG}"
    exit 1
fi


if [ ! -f "${TEACHER_CKPT}" ]; then
    echo "FATAL: teacher checkpoint not found:"
    echo "  ${TEACHER_CKPT}"
    exit 1
fi


# ==============================================================================
# Fail-closed paper configuration checks.
# ==============================================================================

if [ "${BITS_KERNEL}" != "4" ]; then
    echo "FATAL: paper main run requires BITS_KERNEL=4"
    exit 1
fi

if [ "${BITS_BIAS}" != "4" ]; then
    echo "FATAL: paper main run requires BITS_BIAS=4"
    exit 1
fi

if [ "${BITS_RECURRENT}" != "4" ]; then
    echo "FATAL: paper main run requires BITS_RECURRENT=4"
    exit 1
fi

if [ "${BITS_ACTIVATION}" != "4" ]; then
    echo "FATAL: paper main run requires BITS_ACTIVATION=4"
    exit 1
fi

if [ "${BITS_STATE}" != "4" ]; then
    echo "FATAL: paper main run requires BITS_STATE=4"
    exit 1
fi

if [ "${STUDENT_UNITS}" != "32" ]; then
    echo "FATAL: paper main run requires STUDENT_UNITS=32"
    exit 1
fi

if [ "${TEACHER_UNITS}" != "128" ]; then
    echo "FATAL: paper main run requires TEACHER_UNITS=128"
    exit 1
fi

if [ "${TEACHER_LAYERS}" != "2" ]; then
    echo "FATAL: paper main run requires TEACHER_LAYERS=2"
    exit 1
fi

if [ "${SEQ_LEN}" != "135" ]; then
    echo "FATAL: paper main run requires SEQ_LEN=135"
    exit 1
fi

if [ "${N_OUT}" != "3" ]; then
    echo "FATAL: paper main run requires N_OUT=3"
    exit 1
fi

if [ "${BATCH_SIZE}" != "1024" ]; then
    echo "FATAL: paper main run requires BATCH_SIZE=1024"
    exit 1
fi


# ==============================================================================
# Fixed primary-paper configuration.
# ==============================================================================

RUN_TAG="paper_main_qkeras_matched"

OUTPUT_LOSS="mse"
QUANTIZER_ALPHA="1.0"
GATE_CURRICULUM="true"
USE_DITHER="false"

P1_EPOCHS=40
P2A_EPOCHS=30
P2B_EPOCHS=30
P2C_EPOCHS=10
P2D_EPOCHS=10

# P2E is 30 epochs so the 15-epoch activation anneal is followed by a genuine
# hard-candidate tail. The previous 10-epoch P2E configuration could not finish
# a 15-epoch anneal before evaluation.
P2E_EPOCHS=30

# P2F contains a 15-epoch state anneal plus a 15-epoch hard-state tail.
P2F_EPOCHS=30

P3_EPOCHS=170

STATE_ANNEAL_EPOCHS=15


if [ "${P2E_EPOCHS}" -le 0 ]; then
    echo "FATAL: P2E may not be skipped in the paper main run."
    exit 1
fi

if [ "${P2F_EPOCHS}" -le 0 ]; then
    echo "FATAL: P2F may not be skipped in the paper main run."
    exit 1
fi

if [ "${P2E_EPOCHS}" -lt "${STATE_ANNEAL_EPOCHS}" ]; then
    echo "FATAL: P2E epochs must be >= annealing epochs."
    exit 1
fi

if [ "${P2F_EPOCHS}" -lt "${STATE_ANNEAL_EPOCHS}" ]; then
    echo "FATAL: P2F epochs must be >= annealing epochs."
    exit 1
fi


# ==============================================================================
# Modules.
# ==============================================================================

module purge
module load gcc/9.3.0/1


# ==============================================================================
# Conda.
# ==============================================================================

eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
conda activate tf210_qkeras


# ==============================================================================
# CUDA/cuDNN.
# ==============================================================================

export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"

export CUDA_VISIBLE_DEVICES=0
export TF_CPP_MIN_LOG_LEVEL=2
export TF_ENABLE_ONEDNN_OPTS=0

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1


# ==============================================================================
# Paths.
# ==============================================================================

SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"
DATA_PATH="${SCRATCH_BASE}/nmi"

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$( cd "${SCRIPT_DIR}/.." && pwd )"

TRAIN_SCRIPT="${REPO_ROOT}/train_student_memoq.py"

SAVE_DIR="/gpfs/u/home/HBNN/HBNNrbss/scratch/nmi"


if [ ! -f "${TRAIN_SCRIPT}" ]; then
    echo "FATAL: train_student_memoq.py not found:"
    echo "  ${TRAIN_SCRIPT}"
    exit 1
fi


# ==============================================================================
# Git provenance guard.
# ==============================================================================

GIT_COMMIT="not-a-git-checkout"

if git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    GIT_COMMIT="$(git -C "${REPO_ROOT}" rev-parse HEAD)"

    GIT_DIRTY="$(git -C "${REPO_ROOT}" status --porcelain)"

    if [ -n "${GIT_DIRTY}" ]; then
        echo "FATAL: repository contains uncommitted changes."
        echo "Commit the exact paper code before launching training."
        echo "${GIT_DIRTY}"
        exit 1
    fi
fi


# ==============================================================================
# Result directory name.
#
# This matches make_job_name() in train_student_memoq.py exactly for this
# launcher.
# ==============================================================================

REF_BATCH_SIZE=1024

EFFECTIVE_LR="$(
    python -c "print(f'{1e-4 * ${BATCH_SIZE} / ${REF_BATCH_SIZE}:.0e}')"
)"

JOB_TAG="${RUN_TAG}_memoq_b${BITS_KERNEL}k${BITS_BIAS}r${BITS_RECURRENT}a${BITS_ACTIVATION}s${BITS_STATE}_gru${STUDENT_UNITS}_dense${N_OUT}_effbs${BATCH_SIZE}_microbs${BATCH_SIZE}_lr${EFFECTIVE_LR}_p1-${P1_EPOCHS}_2a${P2A_EPOCHS}_2b${P2B_EPOCHS}_2c${P2C_EPOCHS}_2d${P2D_EPOCHS}_2e${P2E_EPOCHS}_2f${P2F_EPOCHS}_p3-${P3_EPOCHS}_mse_q1_curr_nodither_aux0"

JOB_RESULTS_DIR="${SAVE_DIR}/results/${JOB_TAG}"

mkdir -p "${JOB_RESULTS_DIR}"


# ==============================================================================
# Scratch/cache directories.
# ==============================================================================

export TMPDIR="${SCRATCH_BASE}/tmp_pip"
export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"
export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"
export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"
export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"

mkdir -p "${TMPDIR}"
mkdir -p "${PIP_CACHE_DIR}"
mkdir -p "${PIP_TMPDIR}"
mkdir -p "${MPLCONFIGDIR}"
mkdir -p "${XDG_CACHE_HOME}"


# ==============================================================================
# TensorFlow GPU sanity check.
# ==============================================================================

GPU_CHECK="$(
    python -c "import tensorflow as tf; print(len(tf.config.list_physical_devices('GPU')))" 2>/dev/null
)"

if [ "${GPU_CHECK}" = "0" ] || [ -z "${GPU_CHECK}" ]; then
    echo "FATAL: TensorFlow found zero GPUs."
    echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH}"
    exit 1
fi


# ==============================================================================
# Log header.
# ==============================================================================

echo "======================================================================"
echo "QKERAS-MATCHED PRIMARY MEMOQ PAPER RUN"
echo "======================================================================"
echo "SLURM JOB ID       : ${SLURM_JOBID}"
echo "SLURM JOB NAME     : ${SLURM_JOB_NAME}"
echo "NODE               : $(hostname)"
echo "RUN TAG            : ${RUN_TAG}"
echo "JOB TAG            : ${JOB_TAG}"
echo "GIT COMMIT         : ${GIT_COMMIT}"
echo "REPO ROOT          : ${REPO_ROOT}"
echo "TRAIN SCRIPT       : ${TRAIN_SCRIPT}"
echo "DATA PATH          : ${DATA_PATH}"
echo "RESULTS            : ${JOB_RESULTS_DIR}"
echo "TEACHER CKPT       : ${TEACHER_CKPT}"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES}"
echo "TF GPU COUNT       : ${GPU_CHECK}"
echo "TF VERSION         : $(python -c 'import tensorflow as tf; print(tf.__version__)' 2>/dev/null)"
echo "QKERAS VERSION     : $(python -c 'import qkeras; print(qkeras.__version__)' 2>/dev/null || echo 'n/a')"
echo "NUMPY VERSION      : $(python -c 'import numpy as np; print(np.__version__)' 2>/dev/null)"
echo "SCIPY VERSION      : $(python -c 'import scipy; print(scipy.__version__)' 2>/dev/null)"
echo "BITS K/B/R/A/S     : ${BITS_KERNEL}/${BITS_BIAS}/${BITS_RECURRENT}/${BITS_ACTIVATION}/${BITS_STATE}"
echo "STUDENT UNITS      : ${STUDENT_UNITS}"
echo "TEACHER            : ${TEACHER_UNITS} x ${TEACHER_LAYERS}"
echo "SEQ LEN            : ${SEQ_LEN}"
echo "N OUT              : ${N_OUT}"
echo "GATE WIDTH NS      : ${GATE_WIDTH_NS}"
echo "BATCH SIZE         : ${BATCH_SIZE}"
echo "OUTPUT LOSS        : ${OUTPUT_LOSS}"
echo "QUANTIZER ALPHA    : ${QUANTIZER_ALPHA}"
echo "GATE CURRICULUM    : ${GATE_CURRICULUM}"
echo "USE DITHER         : ${USE_DITHER}"
echo "P1                 : ${P1_EPOCHS}"
echo "P2A                : ${P2A_EPOCHS}"
echo "P2B                : ${P2B_EPOCHS}"
echo "P2C                : ${P2C_EPOCHS}"
echo "P2D                : ${P2D_EPOCHS}"
echo "P2E                : ${P2E_EPOCHS}"
echo "P2F                : ${P2F_EPOCHS}"
echo "P3                 : ${P3_EPOCHS}"
echo "STATE ANNEAL       : ${STATE_ANNEAL_EPOCHS}"
echo "AUX LOSSES         : ALL ZERO"
echo "RESUME             : ${RESUME_FLAG:-false}"
echo "======================================================================"


# ==============================================================================
# Resume preflight.
# ==============================================================================

if [ "${RESUME_FLAG}" = "--resume" ]; then
    RESUME_STATE="${JOB_RESULTS_DIR}/resume_state.json"

    echo "RESUME MODE"

    if [ -f "${JOB_RESULTS_DIR}/training_complete.flag" ]; then
        echo "training_complete.flag already exists."
        echo "Python will load the final checkpoint and evaluate without retraining."
    fi

    if [ -f "${RESUME_STATE}" ]; then
        echo "Resume state:"
        cat "${RESUME_STATE}"
    else
        echo "No resume_state.json exists yet."
        echo "The Python training code will start from the beginning."
    fi
fi


# ==============================================================================
# Auto-resubmission trap.
# ==============================================================================

RESUBMIT=0
PYTHON_PID=""

resubmit_handler() {
    echo "======================================================================"
    echo "SIGUSR1 received."
    echo "Wall-time limit is approaching."
    echo "The next job will resume from the last completed epoch."
    echo "======================================================================"

    RESUBMIT=1
}

trap resubmit_handler SIGUSR1


# ==============================================================================
# Launch training.
# ==============================================================================

python "${TRAIN_SCRIPT}" \
    --data-dir "${DATA_PATH}" \
    --teacher-ckpt "${TEACHER_CKPT}" \
    --save-dir "${SAVE_DIR}" \
    --run-tag "${RUN_TAG}" \
    --bits-kernel "${BITS_KERNEL}" \
    --bits-bias "${BITS_BIAS}" \
    --bits-recurrent "${BITS_RECURRENT}" \
    --bits-activation "${BITS_ACTIVATION}" \
    --bits-state "${BITS_STATE}" \
    --student-units "${STUDENT_UNITS}" \
    --teacher-units "${TEACHER_UNITS}" \
    --teacher-layers "${TEACHER_LAYERS}" \
    --seq-len "${SEQ_LEN}" \
    --n-out "${N_OUT}" \
    --gate-width-ns "${GATE_WIDTH_NS}" \
    --batch-size "${BATCH_SIZE}" \
    --lr 1e-4 \
    --ref-batch-size 1024 \
    --lr-factor 0.5 \
    --lr-patience 8 \
    --lr-min 1e-6 \
    --patience 30 \
    --min-delta 1e-5 \
    --warmup-epochs 5 \
    --temperature 4.0 \
    --alpha 0.7 \
    --output-loss mse \
    --quantizer-alpha 1.0 \
    --memoq-gate-curriculum true \
    --memoq-use-dither false \
    --memoq-warmup-epochs "${P1_EPOCHS}" \
    --memoq-stage2a-epochs "${P2A_EPOCHS}" \
    --memoq-stage2b-epochs "${P2B_EPOCHS}" \
    --memoq-stage2c-epochs "${P2C_EPOCHS}" \
    --memoq-stage2d-epochs "${P2D_EPOCHS}" \
    --memoq-stage2e-epochs "${P2E_EPOCHS}" \
    --memoq-stage2f-epochs "${P2F_EPOCHS}" \
    --memoq-state-anneal-epochs "${STATE_ANNEAL_EPOCHS}" \
    --memoq-finetune-epochs "${P3_EPOCHS}" \
    --memoq-lr-mult-p1 1.0 \
    --memoq-lr-mult-p2a 0.5 \
    --memoq-lr-mult-p2b 0.5 \
    --memoq-lr-mult-p2c 0.5 \
    --memoq-lr-mult-p2d 0.3 \
    --memoq-lr-mult-p2e 0.3 \
    --memoq-lr-mult-p2f 0.3 \
    --memoq-lr-mult-p3 0.1 \
    --memoq-phase3-lr-floor 5e-6 \
    --memoq-huber-delta 0.1 \
    --memoq-rho-z 0.98 \
    --memoq-rho-rail 0.90 \
    --memoq-mu-rail 0.0 \
    --memoq-innov-burnin 5 \
    --memoq-lambda-mem-p2a 0.0 \
    --memoq-lambda-innov-p2a 0.0 \
    --memoq-lambda-zsat-p2a 0.0 \
    --memoq-lambda-rail-p2a 0.0 \
    --memoq-lambda-shape-p2a 0.0 \
    --memoq-lambda-mem-p2b 0.0 \
    --memoq-lambda-innov-p2b 0.0 \
    --memoq-lambda-zsat-p2b 0.0 \
    --memoq-lambda-rail-p2b 0.0 \
    --memoq-lambda-shape-p2b 0.0 \
    --memoq-lambda-mem-p2c 0.0 \
    --memoq-lambda-innov-p2c 0.0 \
    --memoq-lambda-zsat-p2c 0.0 \
    --memoq-lambda-rail-p2c 0.0 \
    --memoq-lambda-shape-p2c 0.0 \
    --memoq-lambda-mem-p2d 0.0 \
    --memoq-lambda-innov-p2d 0.0 \
    --memoq-lambda-zsat-p2d 0.0 \
    --memoq-lambda-rail-p2d 0.0 \
    --memoq-lambda-shape-p2d 0.0 \
    --memoq-lambda-mem-p2e 0.0 \
    --memoq-lambda-innov-p2e 0.0 \
    --memoq-lambda-zsat-p2e 0.0 \
    --memoq-lambda-rail-p2e 0.0 \
    --memoq-lambda-shape-p2e 0.0 \
    --memoq-lambda-mem-p2f 0.0 \
    --memoq-lambda-innov-p2f 0.0 \
    --memoq-lambda-zsat-p2f 0.0 \
    --memoq-lambda-rail-p2f 0.0 \
    --memoq-lambda-shape-p2f 0.0 \
    --memoq-lambda-mem-p3 0.0 \
    --memoq-lambda-innov-p3 0.0 \
    --memoq-lambda-zsat-p3 0.0 \
    --memoq-lambda-rail-p3 0.0 \
    --memoq-lambda-shape-p3 0.0 \
    --log-interval 10 \
    --infer-batch 8192 \
    --prefetch-batches 32 \
    --pipeline-workers 4 \
    --split-seed 42 \
    ${RESUME_FLAG} \
    &

PYTHON_PID=$!

echo "Python PID: ${PYTHON_PID}"
echo "Waiting for training process..."

wait "${PYTHON_PID}"

EXIT_CODE=$?

echo "Python exit code: ${EXIT_CODE}"


# ==============================================================================
# SIGTERM handling.
# ==============================================================================

if [ "${EXIT_CODE}" = "143" ] && [ "${RESUBMIT}" = "0" ]; then
    echo "Python received SIGTERM before completion."
    echo "Treating this as wall-time preemption."
    RESUBMIT=1
fi


# ==============================================================================
# Decide whether another SLURM job is required.
# ==============================================================================

RESUME_STATE_FILE="${JOB_RESULTS_DIR}/resume_state.json"
COMPLETION_FLAG="${JOB_RESULTS_DIR}/training_complete.flag"

DO_RESUBMIT=0


if [ "${RESUBMIT}" = "1" ]; then
    if [ -f "${COMPLETION_FLAG}" ]; then
        echo "Training completed before preemption."
        DO_RESUBMIT=0
    else
        DO_RESUBMIT=1
    fi

elif [ "${EXIT_CODE}" = "0" ]; then
    if [ -f "${COMPLETION_FLAG}" ]; then
        echo "training_complete.flag found."
        DO_RESUBMIT=0

    elif [ -f "${RESUME_STATE_FILE}" ]; then
        echo "Python exited cleanly without completion flag."
        echo "Resubmitting from resume_state.json."
        DO_RESUBMIT=1

    else
        echo "Python exited cleanly but no completion or resume state exists."
        echo "Not resubmitting automatically."
        DO_RESUBMIT=0
    fi

else
    echo "Python failed with exit code ${EXIT_CODE}."
    echo "Not resubmitting a failed scientific run automatically."
    DO_RESUBMIT=0
fi


# ==============================================================================
# Resubmit.
# ==============================================================================

if [ "${DO_RESUBMIT}" = "1" ]; then
    echo "Submitting continuation job..."

    NEW_JOB_ID="$(
        sbatch \
            --parsable \
            --job-name="${SLURM_JOB_NAME}" \
            "${SCRIPT_DIR}/studentmemoq" \
            "${BITS_KERNEL}" \
            "${BITS_BIAS}" \
            "${BITS_RECURRENT}" \
            "${BITS_ACTIVATION}" \
            "${BITS_STATE}" \
            "${STUDENT_UNITS}" \
            "${TEACHER_UNITS}" \
            "${TEACHER_LAYERS}" \
            "${SEQ_LEN}" \
            "${N_OUT}" \
            "${GATE_WIDTH_NS}" \
            "${BATCH_SIZE}" \
            "${TEACHER_CKPT}" \
            "--resume"
    )"

    SBATCH_RC=$?

    if [ "${SBATCH_RC}" = "0" ]; then
        echo "Continuation submitted."
        echo "New SLURM job ID: ${NEW_JOB_ID}"
    else
        echo "ERROR: continuation submission failed."
        exit "${SBATCH_RC}"
    fi
fi


# ==============================================================================
# Summary.
# ==============================================================================

echo "======================================================================"
echo "RUN SUMMARY"
echo "======================================================================"
echo "Exit code: ${EXIT_CODE}"
echo "Results: ${JOB_RESULTS_DIR}"
echo "H5 files   : $(find "${JOB_RESULTS_DIR}" -name "*.h5" 2>/dev/null | wc -l)"
echo "MAT files  : $(find "${JOB_RESULTS_DIR}" -name "*.mat" 2>/dev/null | wc -l)"
echo "PNG files  : $(find "${JOB_RESULTS_DIR}" -name "*.png" 2>/dev/null | wc -l)"
echo "PDF files  : $(find "${JOB_RESULTS_DIR}" -name "*.pdf" 2>/dev/null | wc -l)"
echo "JSON files : $(find "${JOB_RESULTS_DIR}" -name "*.json" 2>/dev/null | wc -l)"
echo "CSV files  : $(find "${JOB_RESULTS_DIR}" -name "*.csv" 2>/dev/null | wc -l)"
echo "======================================================================"

exit "${EXIT_CODE}"