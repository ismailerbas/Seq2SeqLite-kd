#!/bin/bash
#SBATCH --output=slurm-%A_%x.out
#SBATCH --error=slurm-%A_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=erbasi@rpi.edu
#SBATCH --signal=B:SIGUSR1@120

# ============================================================================
# G-TRAC-Q / MemoQ Student Training  (train_student_memoq.py)
# All 8 GPUs used via MirroredStrategy inside train_student_memoq.py.
#
# Auto-resubmission logic:
#   - SIGUSR1 fires 120s before wall time -> sets RESUBMIT=1 IMMEDIATELY
#     (Python runs in background so the trap is not deferred).
#     Python finishes its current epoch, then job resubmits itself with --resume.
#   - Python exits 0 cleanly within wall time -> check resume_state.json:
#     if start_epoch < TOTAL_EPOCHS and no early stop, resubmit with --resume.
#   - Python exits 0 and resume_state.json says training is done -> no resubmit.
#   - Python exits non-zero and RESUBMIT=0 -> hard failure, no resubmit.
#   - Python killed by SIGTERM (exit 143) and RESUBMIT=0 -> treat as
#     wall-time preemption (SIGUSR1 race condition), resubmit with --resume.
#
# KEY FIX (inherited from slurm/student):
#   Python is launched in BACKGROUND with & and the shell waits via
#   `wait $PYTHON_PID`. This makes the SIGUSR1 trap fire IMMEDIATELY when
#   the signal arrives instead of being deferred until Python exits.
#
# Usage:
#   sbatch --job-name=memoq_full_gru32_bs1024 \
#          studentmemoq \
#          <BITS_KERNEL> <BITS_BIAS> <BITS_RECURRENT> <BITS_ACTIVATION> \
#          <BITS_STATE> <STUDENT_UNITS> <TEACHER_UNITS> <TEACHER_LAYERS> \
#          <SEQ_LEN> <N_OUT> <GATE_WIDTH_NS> <BATCH_SIZE> <TEACHER_CKPT> \
#          [--resume] [--mixed-precision]
#
# Example fresh full-model run (ladder F):
#   sbatch --job-name=memoq_full_gru32_bs1024 \
#          studentmemoq \
#          4 4 4 4 4 32 128 2 135 3 0.09 1024 \
#          /gpfs/u/scratch/HBNN/HBNNrbss/nmi/teacher_best.weights.h5
#
# Example resume:
#   sbatch --job-name=memoq_full_gru32_bs1024 \
#          studentmemoq \
#          4 4 4 4 4 32 128 2 135 3 0.09 1024 \
#          /gpfs/u/scratch/HBNN/HBNNrbss/nmi/teacher_best.weights.h5 \
#          --resume
# ============================================================================



# --- Positional arguments ---
BITS_KERNEL=$1
BITS_BIAS=$2
BITS_RECURRENT=$3
BITS_ACTIVATION=$4
BITS_STATE=$5
STUDENT_UNITS=$6
TEACHER_UNITS=$7
TEACHER_LAYERS=$8
SEQ_LEN=$9
N_OUT=${10}
GATE_WIDTH_NS=${11}
BATCH_SIZE=${12}
TEACHER_CKPT=${13}
RESUME_FLAG=${14:-""}
MIXED_PRECISION_FLAG=${15:-""}



# --- Required argument check ---
if [ -z "${BITS_KERNEL}"    ] || [ -z "${BITS_BIAS}"        ] || \
   [ -z "${BITS_RECURRENT}" ] || [ -z "${BITS_ACTIVATION}"  ] || \
   [ -z "${BITS_STATE}"     ] || [ -z "${STUDENT_UNITS}"    ] || \
   [ -z "${TEACHER_UNITS}"  ] || [ -z "${TEACHER_LAYERS}"   ] || \
   [ -z "${SEQ_LEN}"        ] || [ -z "${N_OUT}"            ] || \
   [ -z "${GATE_WIDTH_NS}"  ] || [ -z "${BATCH_SIZE}"       ] || \
   [ -z "${TEACHER_CKPT}"   ]; then
    echo "FATAL: Missing positional arguments."
    echo "Usage: sbatch studentmemoq BITS_KERNEL BITS_BIAS BITS_RECURRENT BITS_ACTIVATION BITS_STATE STUDENT_UNITS TEACHER_UNITS TEACHER_LAYERS SEQ_LEN N_OUT GATE_WIDTH_NS BATCH_SIZE TEACHER_CKPT [--resume] [--mixed-precision]"
    exit 1
fi



# --- Teacher checkpoint existence check ---
if [ ! -f "${TEACHER_CKPT}" ]; then
    echo "FATAL: teacher checkpoint not found: ${TEACHER_CKPT}"
    exit 1
fi



# --- Validate RESUME_FLAG if provided ---
if [ -n "${RESUME_FLAG}" ] && \
   [ "${RESUME_FLAG}" != "--resume" ] && \
   [ "${RESUME_FLAG}" != "--mixed-precision" ]; then
    echo "FATAL: argument 14 must be --resume or --mixed-precision, got: ${RESUME_FLAG}"
    exit 1
fi



# ============================================================================
# STEP 1 - modules
# ============================================================================
module purge
module load gcc/9.3.0/1



# ============================================================================
# STEP 2 - activate conda
# ============================================================================
eval "$(/gpfs/u/scratch/HBNN/HBNNrbss/miniconda3x86/bin/conda shell.bash hook)"
conda activate tf210_qkeras



# ============================================================================
# STEP 3 - cuDNN fix
# libcudnn.so.8 is in $CONDA_PREFIX/lib but LD_LIBRARY_PATH is empty on
# this cluster. TF cannot find cuDNN without this one export.
# ============================================================================
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"



# ============================================================================
# STEP 4 - GPU / TF settings
# ===========================================================================
export CUDA_VISIBLE_DEVICES=0
export TF_CPP_MIN_LOG_LEVEL=2
export TF_ENABLE_ONEDNN_OPTS=0
# Do NOT set TF_FORCE_GPU_ALLOW_GROWTH here -- train_student_memoq.py calls
# set_memory_growth() programmatically. Setting both causes a RuntimeError.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1



# --- Paths ---
SCRATCH_BASE="/gpfs/u/scratch/HBNN/HBNNrbss"
DATA_PATH="${SCRATCH_BASE}/nmi"
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"



# --- Results subfolder: matches make_job_name() in train_student_memoq.py exactly ---
REF_BATCH_SIZE=1024
EFFECTIVE_LR=$(python -c "print(f'{1e-4 * ${BATCH_SIZE} / ${REF_BATCH_SIZE}:.0e}')" 2>/dev/null || echo "1e-4")

JOB_TAG="memoq_b${BITS_KERNEL}k${BITS_BIAS}r${BITS_RECURRENT}a${BITS_ACTIVATION}s${BITS_STATE}_gru${STUDENT_UNITS}_dense${N_OUT}_effbs${BATCH_SIZE}_microbs${BATCH_SIZE}_lr${EFFECTIVE_LR}_p1-40_2a30_2b30_2c30_p3-170"



# SAVE_DIR points to the root under which results/JOB_TAG is built.
# train_student_memoq.py constructs: job_dir = save_dir/results/JOB_TAG
SAVE_DIR="/gpfs/u/home/HBNN/HBNNrbss/scratch/nmi"
mkdir -p "${SAVE_DIR}/results/${JOB_TAG}"



# --- Scratch / cache dirs ---
export TMPDIR="${SCRATCH_BASE}/tmp_pip"
export PIP_CACHE_DIR="${SCRATCH_BASE}/pip_cache"
export PIP_TMPDIR="${SCRATCH_BASE}/tmp_pip"
export MPLCONFIGDIR="${SCRATCH_BASE}/mpl_cache"
export XDG_CACHE_HOME="${SCRATCH_BASE}/xdg_cache"
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}" "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"



# ============================================================================
# STEP 5 - Auto-resubmission trap
#
# Python is launched in BACKGROUND below so the SIGUSR1 trap fires
# IMMEDIATELY when the signal arrives. With a foreground process, bash
# defers all traps until the foreground command exits.
# ============================================================================
RESUBMIT=0
PYTHON_PID=""

resubmit_handler() {
    echo "============================================================"
    echo "SIGUSR1 received: wall time limit approaching in ~120 seconds."
    echo "Flagging for resubmission. Python will finish its current epoch."
    echo "resume_state.json will be written by train_student_memoq.py before it exits."
    echo "============================================================"
    RESUBMIT=1
}

trap resubmit_handler SIGUSR1



# --- Log header ---
echo "============================================================"
echo "G-TRAC-Q / MemoQ STUDENT TRAINING  (train_student_memoq.py)"
echo "MirroredStrategy -- all 8 GPUs"
echo "============================================================"
echo "SLURM JOB ID   : ${SLURM_JOBID}"
echo "SLURM JOB NAME : ${SLURM_JOB_NAME}"
echo "JOB TAG        : ${JOB_TAG}"
echo "NODE           : $(hostname)"
echo "CUDA_VISIBLE_DEVICES : ${CUDA_VISIBLE_DEVICES}"
echo "LD_LIBRARY_PATH: ${LD_LIBRARY_PATH}"
echo "GPUs available : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l)"
echo "GPU names      : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
echo "DATA PATH      : ${DATA_PATH}"
echo "SAVE DIR       : ${SAVE_DIR}/results/${JOB_TAG}"
echo "SCRIPT DIR     : ${SCRIPT_DIR}"
echo "BITS KERNEL    : ${BITS_KERNEL}"
echo "BITS BIAS      : ${BITS_BIAS}"
echo "BITS RECURRENT : ${BITS_RECURRENT}"
echo "BITS ACTIVATION: ${BITS_ACTIVATION}"
echo "BITS STATE     : ${BITS_STATE}"
echo "STUDENT UNITS  : ${STUDENT_UNITS}"
echo "TEACHER UNITS  : ${TEACHER_UNITS}"
echo "TEACHER LAYERS : ${TEACHER_LAYERS}"
echo "SEQ LEN        : ${SEQ_LEN}"
echo "N OUT          : ${N_OUT}"
echo "GATE WIDTH NS  : ${GATE_WIDTH_NS}"
echo "BATCH SIZE     : ${BATCH_SIZE}"
echo "TEACHER CKPT   : ${TEACHER_CKPT}"
echo "RESUME FLAG    : ${RESUME_FLAG:-off}"
echo "MIXED PREC     : ${MIXED_PRECISION_FLAG:-off}"
echo "PYTHON         : $(which python)"
echo "TF VERSION     : $(python -c 'import tensorflow as tf; print(tf.__version__)' 2>/dev/null)"
echo "QKERAS VERSION : $(python -c 'import qkeras; print(qkeras.__version__)' 2>/dev/null || echo 'n/a')"
echo "NUMPY VERSION  : $(python -c 'import numpy as np; print(np.__version__)' 2>/dev/null)"
echo "============================================================"



# --- If resuming: verify that phase checkpoints exist before launching ---
if [ "${RESUME_FLAG}" = "--resume" ]; then
    JOB_RESULTS_DIR="${SAVE_DIR}/results/${JOB_TAG}"
    RESUME_STATE="${JOB_RESULTS_DIR}/resume_state.json"
    echo "RESUME MODE: checking for required files..."
    echo "  Job dir      : ${JOB_RESULTS_DIR}"
    echo "  Resume state : ${RESUME_STATE}"

    FOUND_CKPT=""
    for CKPT_NAME in "student_best.weights.h5" "stage2c_best.weights.h5" "stage2b_best.weights.h5" "stage2a_best.weights.h5" "phase1_best.weights.h5"; do
        if [ -f "${JOB_RESULTS_DIR}/${CKPT_NAME}" ]; then
            FOUND_CKPT="${JOB_RESULTS_DIR}/${CKPT_NAME}"
            echo "  Found checkpoint : ${FOUND_CKPT}"
            break
        fi
    done

    if [ -z "${FOUND_CKPT}" ]; then
        echo "  No checkpoint found in ${JOB_RESULTS_DIR}."
        echo "  Checked: student_best.weights.h5, stage2c_best.weights.h5, stage2b_best.weights.h5, stage2a_best.weights.h5, phase1_best.weights.h5"
        echo "  No prior checkpoint -- train_student_memoq.py will start from Phase 1 (--resume is a no-op for a fresh directory)."
    fi

    if [ ! -f "${RESUME_STATE}" ]; then
        echo "WARNING: resume_state.json not found at:"
        echo "  ${RESUME_STATE}"
        echo "train_student_memoq.py will handle this gracefully (loads weights, starts from phase 1)."
    else
        echo "  resume_state.json found OK."
        echo "  Contents:"
        cat "${RESUME_STATE}"
    fi
    echo "============================================================"
fi



# --- GPU sanity check ---
GPU_CHECK=$(python -c "import tensorflow as tf; gpus=tf.config.list_physical_devices('GPU'); print(len(gpus))" 2>/dev/null)
echo "TF physical GPUs found : ${GPU_CHECK}"
if [ "${GPU_CHECK}" = "0" ] || [ -z "${GPU_CHECK}" ]; then
    echo "FATAL: TensorFlow found 0 GPUs."
    echo "Check LD_LIBRARY_PATH includes \$CONDA_PREFIX/lib"
    echo "libcudnn.so.8 location:"
    find "${CONDA_PREFIX}/lib" -name "libcudnn.so.8" 2>/dev/null
    exit 1
fi



# --- Script existence check ---
if [ ! -f "${SCRIPT_DIR}/train_student_memoq.py" ]; then
    echo "FATAL: train_student_memoq.py not found in ${SCRIPT_DIR}"
    exit 1
fi
echo "train_student_memoq.py found."
echo "Starting G-TRAC-Q / MemoQ student training..."
echo "============================================================"



# ============================================================================
# Launch Python in BACKGROUND -- critical for SIGUSR1 trap to fire immediately.
# Full-model run (ladder F): gate curriculum ON, huber_cn output loss,
# all per-phase auxiliary lambdas set for mem / innov / zsat / rail / shape.
# ============================================================================
python "${SCRIPT_DIR}/train_student_memoq.py" \
    --data-dir                      "${DATA_PATH}"           \
    --teacher-ckpt                  "${TEACHER_CKPT}"        \
    --save-dir                      "${SAVE_DIR}"            \
    --bits-kernel                   "${BITS_KERNEL}"         \
    --bits-bias                     "${BITS_BIAS}"           \
    --bits-recurrent                "${BITS_RECURRENT}"      \
    --bits-activation               "${BITS_ACTIVATION}"     \
    --bits-state                    "${BITS_STATE}"          \
    --student-units                 "${STUDENT_UNITS}"       \
    --teacher-units                 "${TEACHER_UNITS}"       \
    --teacher-layers                "${TEACHER_LAYERS}"      \
    --seq-len                       "${SEQ_LEN}"             \
    --n-out                         "${N_OUT}"               \
    --gate-width-ns                 "${GATE_WIDTH_NS}"       \
    --batch-size                    "${BATCH_SIZE}"          \
    --lr                            1e-4                     \
    --ref-batch-size                1024                     \
    --lr-factor                     0.5                      \
    --lr-patience                   8                        \
    --lr-min                        1e-6                     \
    --patience                      30                       \
    --min-delta                     1e-5                     \
    --temperature                   4.0                      \
    --alpha                         0.7                      \
    --output-loss                   mse                      \
    --quantizer-alpha               1.0                      \
    --memoq-gate-curriculum         true                     \
    --memoq-warmup-epochs           40                       \
    --memoq-stage2a-epochs          30                       \
    --memoq-stage2b-epochs          30                       \
    --memoq-stage2c-epochs          30                       \
    --memoq-finetune-epochs         170                      \
    --memoq-lr-mult-p1              1.0                      \
    --memoq-lr-mult-p2a             0.5                      \
    --memoq-lr-mult-p2b             0.5                      \
    --memoq-lr-mult-p2c             0.5                      \
    --memoq-lr-mult-p3              0.1                      \
    --memoq-phase3-lr-floor         5e-6                     \
    --memoq-huber-delta             0.1                      \
    --memoq-rho-z                   0.98                     \
    --memoq-rho-rail                0.90                     \
    --memoq-mu-rail                 0.0                      \
    --memoq-innov-burnin            5                        \
    --memoq-lambda-mem-p2a          0.03                     \
    --memoq-lambda-mem-p2b          0.03                     \
    --memoq-lambda-mem-p2c          0.03                     \
    --memoq-lambda-mem-p3           0.03                     \
    --memoq-lambda-innov-p2a        0.005                    \
    --memoq-lambda-innov-p2b        0.005                    \
    --memoq-lambda-innov-p2c        0.005                    \
    --memoq-lambda-innov-p3         0.005                    \
    --memoq-lambda-zsat-p2a         0.002                    \
    --memoq-lambda-zsat-p2b         0.002                    \
    --memoq-lambda-zsat-p2c         0.002                    \
    --memoq-lambda-zsat-p3          0.002                    \
    --memoq-lambda-rail-p2a         0.001                    \
    --memoq-lambda-rail-p2b         0.001                    \
    --memoq-lambda-rail-p2c         0.001                    \
    --memoq-lambda-rail-p3          0.001                    \
    --memoq-lambda-shape-p2a        0.0                      \
    --memoq-lambda-shape-p2b        0.0                      \
    --memoq-lambda-shape-p2c        0.01                     \
    --memoq-lambda-shape-p3         0.01                     \
    --log-interval                  10                       \
    --infer-batch                   8192                     \
    --prefetch-batches              32                       \
    --pipeline-workers              4                        \
    --split-seed                    42                       \
    ${RESUME_FLAG}                                           \
    ${MIXED_PRECISION_FLAG}                                  \
    &

PYTHON_PID=$!
echo "Python launched in background. PID=${PYTHON_PID}"
echo "Waiting for Python to finish (wait is interruptible by SIGUSR1)..."

wait ${PYTHON_PID}
EXIT_CODE=$?

echo "Python process ${PYTHON_PID} exited with code: ${EXIT_CODE}"



# ============================================================================
# SIGTERM hardening: exit 143 without prior SIGUSR1 = wall-time preemption.
# resume_state.json from last completed epoch is intact -- safe to resubmit.
# ============================================================================
if [ "${EXIT_CODE}" = "143" ] && [ "${RESUBMIT}" = "0" ]; then
    echo "============================================================"
    echo "Python was killed by SIGTERM (exit 143) without a prior SIGUSR1."
    echo "Treating as wall-time preemption. Flagging for resubmission."
    echo "resume_state.json from the last completed epoch will be used."
    echo "============================================================"
    RESUBMIT=1
fi



# ============================================================================
# STEP 6 - Auto-resubmission block
#
# MemoQ total epoch count = warmup + 2A + 2B + 2C + finetune
# = 40 + 30 + 30 + 30 + 170 = 300 (matches TOTAL_EPOCHS below).
# ============================================================================
RESUME_STATE_FILE="${SAVE_DIR}/results/${JOB_TAG}/resume_state.json"
COMPLETION_FLAG="${SAVE_DIR}/results/${JOB_TAG}/training_complete.flag"
DO_RESUBMIT=0

if [ "${RESUBMIT}" = "1" ]; then
    echo "============================================================"
    echo "RESUBMIT reason: SIGUSR1 fired or SIGTERM preemption detected."
    if [ -f "${COMPLETION_FLAG}" ]; then
        echo "  training_complete.flag found — training was finished before preemption."
        echo "  No resubmission needed."
        DO_RESUBMIT=0
    else
        DO_RESUBMIT=1
    fi

elif [ "${EXIT_CODE}" = "0" ]; then
    echo "============================================================"
    echo "Python exited 0. Checking training_complete.flag..."

    if [ -f "${COMPLETION_FLAG}" ]; then
        echo "  training_complete.flag found — all phases finished."
        echo "  No resubmission needed."
        DO_RESUBMIT=0

    elif [ -f "${RESUME_STATE_FILE}" ]; then
        RESUME_STAGE=$(python -c "
import json, sys
try:
    s = json.load(open('${RESUME_STATE_FILE}'))
    print(s.get('stage', 'P1'))
except Exception as e:
    print('P1')
" 2>/dev/null)
        RESUME_EP=$(python -c "
import json, sys
try:
    s = json.load(open('${RESUME_STATE_FILE}'))
    print(int(s.get('epoch_in_stage', 0)))
except Exception as e:
    print(0)
" 2>/dev/null)
        echo "  resume_state.json found — stage=${RESUME_STAGE}  epoch_in_stage=${RESUME_EP}"
        echo "  (No completion flag — treating as incomplete run, resubmitting.)"
        DO_RESUBMIT=1

    else
        echo "  No training_complete.flag and no resume_state.json found at:"
        echo "    ${COMPLETION_FLAG}"
        echo "    ${RESUME_STATE_FILE}"
        echo "  Cannot determine training state. Not resubmitting to avoid loop."
        echo "  If training is incomplete, resubmit manually with --resume."
        DO_RESUBMIT=0
    fi

else
    echo "============================================================"
    echo "Python exited with error code ${EXIT_CODE}. Not resubmitting."
    echo "Fix the error first, then resubmit manually with --resume."
    DO_RESUBMIT=0
fi


# --- Execute resubmission ---
if [ "${DO_RESUBMIT}" = "1" ]; then
    echo "AUTO-RESUBMIT: submitting next job with --resume..."
    echo "  Script   : ${SCRIPT_DIR}/studentmemoq"
    echo "  Job name : ${SLURM_JOB_NAME}"
    NEW_JOB_ID=$(sbatch \
        --parsable \
        --job-name="${SLURM_JOB_NAME}" \
        "${SCRIPT_DIR}/studentmemoq"   \
        "${BITS_KERNEL}"               \
        "${BITS_BIAS}"                 \
        "${BITS_RECURRENT}"            \
        "${BITS_ACTIVATION}"           \
        "${BITS_STATE}"                \
        "${STUDENT_UNITS}"             \
        "${TEACHER_UNITS}"             \
        "${TEACHER_LAYERS}"            \
        "${SEQ_LEN}"                   \
        "${N_OUT}"                     \
        "${GATE_WIDTH_NS}"             \
        "${BATCH_SIZE}"                \
        "${TEACHER_CKPT}"              \
        "--resume"                     \
        "${MIXED_PRECISION_FLAG}"
    )
    SBATCH_RC=$?
    if [ "${SBATCH_RC}" = "0" ]; then
        echo "  Resubmitted successfully. New SLURM job ID: ${NEW_JOB_ID}"
        echo "  Monitor with: squeue --job ${NEW_JOB_ID}"
    else
        echo "  ERROR: sbatch resubmission FAILED (rc=${SBATCH_RC})"
        echo "  Resubmit manually:"
        echo "    sbatch --job-name=${SLURM_JOB_NAME} ${SCRIPT_DIR}/studentmemoq \\"
        echo "      ${BITS_KERNEL} ${BITS_BIAS} ${BITS_RECURRENT} ${BITS_ACTIVATION} \\"
        echo "      ${BITS_STATE} ${STUDENT_UNITS} ${TEACHER_UNITS} ${TEACHER_LAYERS} \\"
        echo "      ${SEQ_LEN} ${N_OUT} ${GATE_WIDTH_NS} ${BATCH_SIZE} \\"
        echo "      ${TEACHER_CKPT} --resume ${MIXED_PRECISION_FLAG}"
    fi
    echo "============================================================"
fi



# --- Final summary ---
echo "============================================================"
echo "Training Exit Code: ${EXIT_CODE}"
if [ ${EXIT_CODE} -eq 0 ]; then
    echo "Completed successfully."
    echo "Results in: ${SAVE_DIR}/results/${JOB_TAG}"
    echo "  H5s   : $(find "${SAVE_DIR}/results/${JOB_TAG}" -name "*.h5"   2>/dev/null | wc -l)"
    echo "  PNGs  : $(find "${SAVE_DIR}/results/${JOB_TAG}" -name "*.png"  2>/dev/null | wc -l)"
    echo "  JSONs : $(find "${SAVE_DIR}/results/${JOB_TAG}" -name "*.json" 2>/dev/null | wc -l)"
    echo "  CSVs  : $(find "${SAVE_DIR}/results/${JOB_TAG}" -name "*.csv"  2>/dev/null | wc -l)"
else
    echo "FAILED or preempted (exit code: ${EXIT_CODE})"
    echo "Check: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
    echo "Hint:"
    echo "  grep -i 'error\|traceback\|valueerror\|modulenotfound\|assertionerror' \\"
    echo "       slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err | head -40"
fi
echo "============================================================"
echo "Log files:"
echo "  Out: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.out"
echo "  Err: slurm-${SLURM_JOBID}_${SLURM_JOB_NAME}.err"
echo "============================================================"



exit ${EXIT_CODE}