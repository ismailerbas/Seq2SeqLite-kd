    student_args.json \
    stage2e_best.weights.h5 \
    stage2f_best.weights.h5 \
    student_best.weights.h5 \
    test_metrics_P2E.json \
    test_metrics_P2F.json

do

    if [ ! -f "${MEMOQ_RUN_DIR}/${REQUIRED_FILE}" ]; then

        echo "FATAL: corrected MemoQ run is incomplete; missing:"
        echo "  ${MEMOQ_RUN_DIR}/${REQUIRED_FILE}"
        exit 1
    fi

done


if [ ! -f "${MEMOQ_RUN_DIR}/test_metrics_P3.json" ] && \
   [ ! -f "${MEMOQ_RUN_DIR}/test_metrics.json" ]; then

    echo "FATAL: corrected MemoQ run has no P3 saved metrics."
    exit 1
fi

VANILLA4_RUN_DIR="${PROJECT_DIR}/results/vanilla_kd_T4.0_a0.6_b4k4r4a4_gru32x1_dense3_effbs1024_microbs1024_lr1e-04"

VANILLA8_RUN_DIR="${PROJECT_DIR}/results/vanilla_kd_T4.0_a0.6_b8k8r8a8_gru32x1_dense3_effbs1024_microbs1024_lr1e-04"


if [ ! -d "${VANILLA4_RUN_DIR}" ]; then
    echo "FATAL: vanilla 4-bit run directory does not exist: ${VANILLA4_RUN_DIR}"
    exit 1
fi


if [ ! -d "${VANILLA8_RUN_DIR}" ]; then
    echo "FATAL: vanilla 8-bit run directory does not exist: ${VANILLA8_RUN_DIR}"
    exit 1
fi

for RUN_DIR in \
    "${VANILLA4_RUN_DIR}" \
    "${VANILLA8_RUN_DIR}"

do

    if [ ! -f "${RUN_DIR}/student_args.json" ] || \
       [ ! -f "${RUN_DIR}/student_best.weights.h5" ] || \
       [ ! -f "${RUN_DIR}/test_metrics.json" ]; then

        echo "FATAL: discovered vanilla run is missing required artifacts: ${RUN_DIR}"
        exit 1
    fi

done


echo "================================================================================"
echo "WRITEBACK EXPERIMENT MATRIX"
echo "================================================================================"

echo "PROJECT DIR      : ${PROJECT_DIR}"

echo "DATA PATH        : ${DATA_PATH}"

echo "MEMOQ RUN        : ${MEMOQ_RUN_DIR}"

echo "VANILLA 4 RUN    : ${VANILLA4_RUN_DIR}"

echo "VANILLA 8 RUN    : ${VANILLA8_RUN_DIR}"

echo "WORKER           : ${WORKER}"

echo "================================================================================"


submit_native() {

    local short_name="$1"
    local run_dir="$2"
    local phase="$3"
    local out_dir="$4"
    local job_id

    job_id="$(
        sbatch \
            --parsable \
            --job-name="wb_${short_name}_fid" \
            "${WORKER}" \
            native_fidelity \
            "${run_dir}" \
            "${phase}" \
            native \
            -1 \
            native \
            -1 \
            "${out_dir}" \
            - \
            5 \
            1000
    )"

    echo "Submitted native fidelity ${short_name}: ${job_id}" >&2

    printf '%s\n' \
        "${job_id}"
}


submit_condition() {

    local dependency="$1"
    local short_name="$2"
    local run_dir="$3"
    local phase="$4"
    local enc_writeback="$5"
    local enc_bits="$6"
    local dec_writeback="$7"
    local dec_bits="$8"
    local out_dir="$9"
    local fidelity_json="${10}"
    local sr_seeds="${11:-5}"
    local sr_seed_base="${12:-1000}"
    local job_id

    job_id="$(
        sbatch \
            --parsable \
            --dependency="afterok:${dependency}" \
            --job-name="wb_${short_name}" \
            "${WORKER}" \
            condition \
            "${run_dir}" \
            "${phase}" \
            "${enc_writeback}" \
            "${enc_bits}" \
            "${dec_writeback}" \
            "${dec_bits}" \
            "${out_dir}" \
            "${fidelity_json}" \
            "${sr_seeds}" \
            "${sr_seed_base}"
    )"

    echo "Submitted condition ${short_name}: ${job_id} after ${dependency}" >&2

    printf '%s\n' \
        "${job_id}"
}


MEMOQ_OUT_ROOT="${MEMOQ_RUN_DIR}/writeback_analysis"

V4_OUT_ROOT="${VANILLA4_RUN_DIR}/writeback_analysis"

V8_OUT_ROOT="${VANILLA8_RUN_DIR}/writeback_analysis"


