submit_native() {

    local short_name="$1"
    local run_dir="$2"
    local phase="$3"
    local out_dir="$4"
    local job_id

    job_id="$(
        sbatch \
            --parsable \
            --job-name="wb_${short_name}_fid" \
            "${WORKER}" \
            native_fidelity \
            "${run_dir}" \
            "${phase}" \
            native \
            -1 \
            native \
            -1 \
            "${out_dir}" \
            - \
            5 \
            1000
    )"

    echo "Submitted native fidelity ${short_name}: ${job_id}" >&2

    printf '%s\n' \
        "${job_id}"
}


submit_condition() {

    local dependency="$1"
    local short_name="$2"
    local run_dir="$3"
    local phase="$4"
    local enc_writeback="$5"
    local enc_bits="$6"
    local dec_writeback="$7"
    local dec_bits="$8"
    local out_dir="$9"
    local fidelity_json="${10}"
    local sr_seeds="${11:-5}"
    local sr_seed_base="${12:-1000}"
    local job_id

    job_id="$(
        sbatch \
            --parsable \
            --dependency="afterok:${dependency}" \
            --job-name="wb_${short_name}" \
            "${WORKER}" \
            condition \
            "${run_dir}" \
            "${phase}" \
            "${enc_writeback}" \
            "${enc_bits}" \
            "${dec_writeback}" \
            "${dec_bits}" \
            "${out_dir}" \
            "${fidelity_json}" \
            "${sr_seeds}" \
            "${sr_seed_base}"
    )"

    echo "Submitted condition ${short_name}: ${job_id} after ${dependency}" >&2

    printf '%s\n' \
        "${job_id}"
}


