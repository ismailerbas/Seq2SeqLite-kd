import json
import math
import sys
from pathlib import Path


root = Path(
    sys.argv[1]
).resolve()


targets = {
    4: (
        0.3220,
        0.3275,
    ),
    8: (
        0.2203,
        0.2229,
    ),
}


def metric(
    payload,
    key,
):
    if (
        key in payload
        and isinstance(
            payload[
                key
            ],
            (
                int,
                float,
            ),
        )
    ):
        return float(
            payload[
                key
            ]
        )

    mapping = {
        "rmse_tau1": (
            "tau1",
            "rmse",
        ),
        "rmse_tau2": (
            "tau2",
            "rmse",
        ),
    }

    outer, inner = mapping[
        key
    ]

    if (
        outer in payload
        and isinstance(
            payload[
                outer
            ],
            dict,
        )
        and inner
        in payload[
            outer
        ]
    ):
        return float(
            payload[
                outer
            ][
                inner
            ]
        )

    return None


def valid_config(
    args,
    bits,
):
    required = {
        "seq_len": 135,
        "n_out": 3,
        "student_units": 32,
        "bits_kernel": bits,
        "bits_bias": bits,
        "bits_recurrent": bits,
        "bits_activation": bits,
        "bits_state": bits,
    }

    for key, expected in (
        required.items()
    ):
        if key not in args:
            return False

        if (
            int(
                args[
                    key
                ]
            )
            != int(
                expected
            )
        ):
            return False

    return True


for bits in (
    4,
    8,
):
    candidates = []

    for args_path in root.glob(
        "*/student_args.json"
    ):
        run_dir = (
            args_path.parent
        )

        checkpoint = (
            run_dir
            / "student_best.weights.h5"
        )

        metrics_path = (
            run_dir
            / "test_metrics.json"
        )

        if (
            not checkpoint.is_file()
            or not metrics_path.is_file()
        ):
            continue

        try:
            args = json.loads(
                args_path.read_text(
                    encoding="utf-8"
                )
            )

            metrics = json.loads(
                metrics_path.read_text(
                    encoding="utf-8"
                )
            )

        except Exception:
            continue

        if not valid_config(
            args,
            bits,
        ):
            continue

        r1 = metric(
            metrics,
            "rmse_tau1",
        )

        r2 = metric(
            metrics,
            "rmse_tau2",
        )

        if (
            r1 is None
            or r2 is None
            or not math.isfinite(
                r1
            )
            or not math.isfinite(
                r2
            )
        ):
            continue

        (
            target1,
            target2,
        ) = targets[
            bits
        ]

        d1 = abs(
            r1
            - target1
        )

        d2 = abs(
            r2
            - target2
        )

        if (
            d1 <= 0.01
            and d2 <= 0.01
        ):
            candidates.append(
                (
                    d1
                    + d2,
                    run_dir,
                    r1,
                    r2,
                )
            )

    candidates.sort(
        key=lambda row: row[0]
    )

    if len(
        candidates
    ) != 1:

        print(
            (
                f"FATAL_DISCOVERY_B{bits}: "
                f"expected exactly one "
                f"vanilla-{bits} paper baseline "
                f"within 0.01 ns of target "
                f"RMSE {targets[bits]}, "
                f"found {len(candidates)}"
            ),
            file=sys.stderr,
        )

        for (
            score,
            run_dir,
            r1,
            r2,
        ) in candidates:

            print(
                (
                    f"  candidate "
                    f"score={score:.6g} "
                    f"rmse_tau1={r1:.9g} "
                    f"rmse_tau2={r2:.9g} "
                    f"path={run_dir}"
                ),
                file=sys.stderr,
            )

        sys.exit(
            2
        )

    print(
        str(
            candidates[
                0
            ][
                1
            ]
        )
    )

PY
)


