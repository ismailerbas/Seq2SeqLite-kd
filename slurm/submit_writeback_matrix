    exit 1
fi


if [ ! -f "${WORKER}" ]; then
    echo "FATAL: writeback worker does not exist: ${WORKER}"
    exit 1
fi


bash -n "${WORKER}"


python -m py_compile \
    "${PROJECT_DIR}/eval/analyze_writeback.py"


if [ ! -d "${MEMOQ_RUN_DIR}" ]; then

    echo "FATAL: corrected paper_main MemoQ run directory does not exist:"
    echo "  ${MEMOQ_RUN_DIR}"
    exit 1
fi


